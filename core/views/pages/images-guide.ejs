          <rect class="guide-box" x="12" y="116" width="190" height="64" rx="8"/><text x="26" y="142">Nestor</text><text class="guide-sub" x="26" y="162">in a private conversation</text>
          <rect class="guide-box" x="12" y="194" width="190" height="64" rx="8"/><text x="26" y="220">Family conversations</text><text class="guide-sub" x="26" y="240">one quick drawing per turn</text>
