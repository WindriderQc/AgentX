<details id="image-constraints" class="image-constraints">
  <summary>Constraints to keep in the brief</summary>
  <p class="image-help">Add the intentions that must stay word for word when Hermes rewrites your brief. Whether the image respects them still needs to be checked.</p>
  <div class="image-constraint-composer">
    <label for="image-constraint-kind">Category</label>
    <select id="image-constraint-kind"><option value="exact-text">Exact text to display</option><option value="required-element">Required element</option><option value="composition">Composition or relation</option></select>
    <label for="image-constraint-text">Your exact intention</label>
    <textarea id="image-constraint-text" rows="2" maxlength="600" placeholder="Example: three machines lined up at the bottom of the image"></textarea>
    <button id="image-constraint-add" type="button">Add the constraint</button>
  </div>
  <ol id="image-constraint-list" class="image-constraint-list"></ol>
  <p id="image-constraints-counter" class="image-help" role="status"></p>
  <p id="image-constraints-notice" class="image-help" role="status"></p>
</details>
