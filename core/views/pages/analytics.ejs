        <!-- LLM Effectiveness: cross-runtime outcomes without merging source ledgers -->
        <div id="llmEffectivenessSection" class="wb-subsection">
            <div class="wb-section-head">
                <h3><i class="fas fa-bullseye" aria-hidden="true"></i> LLM effectiveness</h3>
                <span class="wb-hint" id="effectivenessSignal">Loading effectiveness telemetry…</span>
                <i class="fas fa-circle-info wb-info" id="effectivenessCoverage" tabindex="0" role="img" aria-label="How outcomes are counted" title="Verified outcomes per unit of tokens, inference time, cost and human intervention. Source-owned usage is selected once per outcome; AgentX never adds mirrored ledger totals together."></i>
                <button type="button" id="effectivenessRefreshBtn" class="wb-button wb-button-quiet" aria-label="Refresh effectiveness"><i class="fas fa-sync-alt"></i></button>
            </div>
            <div class="wb-strip">
                <div class="wb-chip"><span class="wb-chip-label">Productive outcomes</span><strong id="effProductive">—</strong><small id="effVerifiedSub">verified work</small></div>
                <div class="wb-chip"><span class="wb-chip-label">Usage attribution</span><strong id="effAttribution">—</strong><small>outcomes linked to usage</small></div>
                <div class="wb-chip" data-hide-empty><span class="wb-chip-label">First-pass success</span><strong id="effFirstPass">—</strong><small id="effFirstPassSub">explicit attempts only</small></div>
                <div class="wb-chip" data-hide-empty><span class="wb-chip-label">Tokens / outcome</span><strong id="effTokensPerOutcome">—</strong><small id="effTokensPerOutcomeSub">includes failed attributed work</small></div>
                <div class="wb-chip" data-hide-empty><span class="wb-chip-label">Inference min / outcome</span><strong id="effComputePerOutcome">—</strong><small id="effHumanPerOutcome">human intervention —</small></div>
                <div class="wb-chip" data-hide-empty><span class="wb-chip-label">Rework rate</span><strong id="effRework">—</strong><small id="effCostPerOutcome">cost / outcome —</small></div>
            </div>
            <div class="wb-table-wrap">
                <table class="wb-table">
                    <thead>
                        <tr><th>Runtime</th><th>Outcomes</th><th>Productive</th><th>Attributed</th><th>Tokens</th><th>Cost</th><th>Rework</th></tr>
                    </thead>
                    <tbody id="effectivenessRuntimeBody">
                        <tr><td colspan="7" class="wb-empty">Loading…</td></tr>
                    </tbody>
                </table>
            </div>
            <p id="effectivenessWaste" class="wb-note">—</p>
        </div>

        <script>
        (function(){
            function number(value){ return value == null ? '—' : Number(value).toLocaleString(undefined, { maximumFractionDigits: 1 }); }
            function pct(value){ return value == null ? '—' : Number(value).toFixed(1) + '%'; }
            function usd(value){ return value == null ? '—' : '$' + Number(value).toFixed(value < 0.01 ? 4 : 2); }
            function esc(value){ return String(value == null ? '' : value).replace(/[&<>"']/g, function(c){ return { '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c]; }); }
            function label(value){ return esc(String(value || 'other').replace(/-/g, ' ').replace(/\b\w/g, function(c){ return c.toUpperCase(); })); }
            // Same period as the rest of the page: "since daily use began" is sent as an explicit range.
            function effectivenessQuery(){
                var select = document.getElementById('analyticsWindow');
                var key = select && select.value || '24h';
                var since = select && select.dataset.usageSince;
                if (key === 'usage' && since) return 'from=' + encodeURIComponent(since) + '&to=' + encodeURIComponent(new Date().toISOString());
                return 'window=' + encodeURIComponent(key === 'usage' ? '24h' : key);
            }
            function hideEmptyChips(root){
                root.querySelectorAll('[data-hide-empty]').forEach(function(chip){
                    var value = (chip.querySelector('strong') || {}).textContent || '';
                    chip.hidden = /^\s*(—|-|n\/a)?\s*$/i.test(value);
                });
            }
            var effectivenessSeq = 0;
            async function loadEffectiveness(){
                var signal = document.getElementById('effectivenessSignal');
                var seq = ++effectivenessSeq;
                try {
                    var response = await fetch('/api/analytics/effectiveness?' + effectivenessQuery(), { signal: AbortSignal.timeout(30000) });
                    var data = await response.json();
                    if (seq !== effectivenessSeq) return;
                    if (!response.ok || !data.ok) throw new Error(data.message || 'Effectiveness API unavailable');
                    var summary = data.summary || {};
                    var waste = data.waste || {};
                    var coverage = data.coverage || {};
                    var signalLabels = {
                        'awaiting-outcomes': 'Awaiting outcome reports',
                        'low-attribution': 'Low attribution coverage',
                        'productive': 'Productive',
                        'needs-attention': 'Needs attention'
                    };
                    signal.innerHTML = '<strong>' + (signalLabels[data.signal?.signal] || label(data.signal?.signal)) + '</strong>' +
                        ' (' + label(data.signal?.confidence) + ' confidence)';
                    signal.title = data.signal?.message || '';
                    document.getElementById('effProductive').textContent = number(summary.productiveOutcomes);
                    document.getElementById('effVerifiedSub').textContent = number(summary.verifiedOutcomes) + ' verified / ' + number(summary.reportedOutcomes) + ' reported';
                    document.getElementById('effAttribution').textContent = pct(summary.attributionCoveragePct);
                    document.getElementById('effFirstPass').textContent = pct(summary.firstPassSuccessRatePct);
                    document.getElementById('effFirstPassSub').textContent = number(coverage.firstPassSampleSize) + ' explicit attempt samples';
                    document.getElementById('effTokensPerOutcome').textContent = number(summary.tokensPerProductiveOutcome);
                    // Show the denominator: these ratios are computed over the
                    // attributed subset, not the whole window.
                    var perOutcomeN = summary.perOutcomeSampleSize;
                    document.getElementById('effTokensPerOutcomeSub').textContent = perOutcomeN
                        ? 'over ' + perOutcomeN + ' of ' + summary.productiveOutcomes + ' productive outcomes'
                        : 'no outcome is linked to usage yet';
                    document.getElementById('effComputePerOutcome').textContent = number(summary.inferenceMinutesPerProductiveOutcome);
                    document.getElementById('effHumanPerOutcome').textContent = summary.humanInterventionSampleSize
                        ? 'human min / outcome ' + number(summary.humanMinutesPerProductiveOutcome) + ' (n=' + summary.humanInterventionSampleSize + ')'
                        : 'human min / outcome not reported';
                    document.getElementById('effRework').textContent = pct(summary.reworkRatePct);
                    document.getElementById('effCostPerOutcome').textContent = summary.costSampleSize
                        ? 'cost / outcome ' + usd(summary.costPerProductiveOutcomeUsd) + ' (n=' + summary.costSampleSize + ')'
                        : 'cost / outcome not reported';
                    hideEmptyChips(document.getElementById('llmEffectivenessSection'));

                    var body = document.getElementById('effectivenessRuntimeBody');
                    if (Array.isArray(data.byRuntime) && data.byRuntime.length) {
                        body.innerHTML = data.byRuntime.map(function(row){
                            return '<tr>' +
                                '<td><strong>' + label(row.runtime) + '</strong></td>' +
                                '<td>' + number(row.outcomes) + '</td>' +
                                '<td>' + number(row.productiveOutcomes) + '</td>' +
                                '<td>' + pct(row.attributionCoveragePct) + '</td>' +
                                '<td>' + number(row.tokens) + '</td>' +
                                '<td>' + usd(row.costUsd) + '</td>' +
                                '<td>' + number(row.reworkCount) + '</td>' +
                                '</tr>';
                        }).join('');
                    } else {
                        body.innerHTML = '<tr><td colspan="7" class="wb-empty">No LLM outcomes in this window.</td></tr>';
                    }
                    document.getElementById('effectivenessWaste').innerHTML =
                        '<strong>Waste signals:</strong> ' + number(waste.failedInferenceCalls) + ' failed calls (' + pct(waste.failedInferenceRatePct) + ') · ' +
                        number(waste.fallbackCalls) + ' fallbacks (' + pct(waste.fallbackRatePct) + ') · ' +
                        number(waste.reworkedOutcomes) + ' reworked · ' + number(waste.unattributedTokens) +
                        ' tokens not linked to an outcome (' + pct(waste.unattributedTokenPct) + ')';
                    document.getElementById('effectivenessCoverage').title =
                        number(coverage.explicitOutcomes) + ' explicit outcome reports + ' + number(coverage.pipelineDerivedOutcomes) +
                        ' operator-verified pipeline outcomes. Samples — first pass: ' + number(coverage.firstPassSampleSize) +
                        ', rework: ' + number(coverage.reworkSampleSize) + ', cost: ' + number(coverage.costSampleSize) +
                        ', human intervention: ' + number(coverage.humanInterventionSampleSize) + '. ' + (coverage.usageAttribution || '');
                } catch (error) {
                    if (seq !== effectivenessSeq) return;
                    signal.innerHTML = '<strong>Effectiveness unavailable</strong> — ' + esc(error.message);
                    document.getElementById('effectivenessRuntimeBody').innerHTML = '<tr><td colspan="7" class="wb-empty">Unable to load effectiveness telemetry.</td></tr>';
                }
            }
            function loadEffectivenessWhenOpen(){
                var gate = window.AgentXAnalyticsCockpit && window.AgentXAnalyticsCockpit.whenOpen;
                return gate ? gate('effectiveness', loadEffectiveness) : loadEffectiveness();
            }
            document.getElementById('effectivenessRefreshBtn')?.addEventListener('click', loadEffectiveness);
            document.getElementById('analyticsWindow')?.addEventListener('change', loadEffectivenessWhenOpen);
            document.getElementById('refreshBtn')?.addEventListener('click', loadEffectiveness);
            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', loadEffectivenessWhenOpen);
            else loadEffectivenessWhenOpen();
        })();
        </script>

        <!-- Usage trend + RAG adoption, side by side -->
        <div class="analytics-split wb-pair chat-lane">
            <div class="wb-subsection">
                <div class="wb-section-head">
