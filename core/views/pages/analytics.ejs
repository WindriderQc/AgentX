        </div>

        <div class="wb-subsection">
            <div class="wb-section-head">
                <h3><i class="fas fa-chart-pie" aria-hidden="true"></i> Cost distribution by model</h3>
                <div class="wb-radio">
                    <label><input type="radio" name="costBreakdownType" id="costBreakdownPie" checked> Pie</label>
                    <label><input type="radio" name="costBreakdownType" id="costBreakdownDonut"> Donut</label>
                </div>
            </div>
            <div id="costBreakdownGrid" class="analytics-split" style="gap: 20px; align-items: start;">
                <div style="position: relative;">
                    <div class="chart-container" style="position: relative; height: 240px;">
                        <canvas id="costBreakdownChart" role="img" aria-label="Cost breakdown chart"></canvas>
                    </div>
                </div>
                <div id="costBreakdownStats" style="display: flex; flex-direction: column; gap: 8px;"></div>
            </div>
            <div class="chart-empty wb-empty" id="costBreakdownEmpty" style="display: none;">No cost breakdown data available.</div>
        </div>
        </div>
        </section>

        <!-- RAG vector store -->
        <section class="wb-section" id="analytics-rag-metrics" aria-labelledby="wb-rag-title">
            <div class="wb-section-head">
                <h3 id="wb-rag-title"><i class="fas fa-cubes" aria-hidden="true"></i> RAG vector store</h3>
                <span class="wb-hint"><i class="fas fa-clock" aria-hidden="true"></i> <span id="ragMetricsTimestamp">—</span> · last ingest <span id="ragLastIngest" title="From the RAG ingest job history; the corpus freshness rule is evaluated against this instant.">—</span></span>
                <button type="button" id="toggleRagHelp" class="wb-button wb-button-quiet" aria-label="RAG metrics help"><i class="fas fa-question-circle"></i></button>
                <button type="button" id="refreshRagBtn" class="wb-button wb-button-quiet"><i class="fas fa-sync-alt"></i> Refresh</button>
            </div>
            <div id="ragHelpPanel" class="wb-note" style="display: none;">
                <h4 style="margin: 0 0 6px;">Understanding RAG Metrics</h4>
                <strong>Chunk count</strong> — typical 12-20 per document (~800 chars per chunk); more chunks give more granular search.
                <strong>Health</strong> — query readiness of the RAG service and corpus freshness, reported separately.
                <button type="button" id="closeRagHelp" aria-label="Close RAG help" class="wb-button wb-button-quiet"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="wb-rag">
                <div class="wb-strip rag-metrics-grid">
                    <div class="wb-chip" title="Unique documents ingested across all sources">
                        <span class="wb-chip-label">Documents</span>
                        <strong id="ragTotalDocs">—</strong>
                        <small>across all sources</small>
                    </div>
                    <div class="wb-chip" title="Embedded vectors stored in Qdrant">
                        <span class="wb-chip-label">Chunks</span>
                        <strong id="ragTotalChunks">—</strong>
                        <small>embedded vectors</small>
                    </div>
                    <div class="wb-chip" title="Average chunks per document">
                        <span class="wb-chip-label">Chunks / doc</span>
                        <strong id="ragAvgChunks">—</strong>
                        <small>chunking</small>
                    </div>
                    <div class="wb-chip" title="Two separate facts: query readiness of the RAG service, and corpus freshness from the recorded ingest history. A healthy service never implies a fresh corpus; no recorded ingest means freshness Unknown.">
                        <span class="wb-chip-label">Store health</span>
                        <strong id="ragHealth">—</strong>
                        <small>readiness · freshness</small>
                    </div>
                </div>
                <div id="ragSourcesTable" class="wb-table-wrap">
                    <table class="wb-table">
                        <thead>
                            <tr><th>Source</th><th>Documents</th><th>Chunks</th><th>Avg chunks</th></tr>
                        </thead>
                        <tbody id="ragSourcesBody">
                            <tr><td colspan="4" class="wb-empty">Loading…</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="chart-empty wb-empty" id="ragEmpty" style="display: none;">No RAG data available.</div>
        </section>

        <!-- Cloud usage. Local inference is in the overview and Model Activity;
             this section keeps the cloud calls routed by AgentX and states
             plainly what it cannot see. Provider-native billing remains
             authoritative for plans, balances and calls that bypass AgentX. -->
        <section class="wb-section" id="federatedSection" aria-labelledby="wb-cloud-title">
            <div class="wb-section-head">
                <h3 id="wb-cloud-title"><i class="fas fa-cloud" aria-hidden="true"></i> Cloud usage</h3>
                <span class="wb-hint" id="fedWindow">routed by AgentX</span>
                <button type="button" id="federatedRefreshBtn" class="wb-button wb-button-quiet" aria-label="Refresh cloud usage"><i class="fas fa-sync-alt"></i></button>
            </div>
            <div id="federatedMcBanner" class="wb-note wb-note-warn" style="display: none;">
                <i class="fas fa-exclamation-triangle" aria-hidden="true"></i> <strong>Provider data unavailable</strong> — AgentX cloud-call aggregation failed.
            </div>
            <div class="wb-strip">
                <div class="wb-chip">
                    <span class="wb-chip-label">Cloud calls via Core</span>
                    <strong id="fedMcSessions">—</strong>
                    <small><span id="fedMcTokens">—</span> tokens</small>
                </div>
                <div class="wb-chip">
                    <span class="wb-chip-label">Spend (est.)</span>
                    <strong id="fedMcSpend">—</strong>
                    <small>as of <span id="fedMcAsOf">—</span></small>
                </div>
                <div class="wb-chip wb-chip-warn" title="Hermes text turns and OpenClaw requests to OpenRouter call their provider directly, so Core does not record them. Their spend appears only in the provider's billing console.">
                    <span class="wb-chip-label">Cloud outside Core</span>
                    <strong>Not measured</strong>
                    <small>Hermes, OpenClaw → OpenRouter</small>
                </div>
            </div>
            <div class="wb-table-wrap" id="fedMcTableWrap">
                <table class="wb-table">
                    <thead>
                        <tr><th>Model</th><th>Provider</th><th>Calls</th><th>Tokens</th><th>Cost</th></tr>
                    </thead>
                    <tbody id="fedMcTableBody">
                        <tr><td colspan="5" class="wb-empty">Loading…</td></tr>
                    </tbody>
                </table>
            </div>
        </section>

        <script>
        // Cloud usage loader (inline, self-contained).
        (function(){
            if (document.body.dataset.agentxProfile === 'demo') {
                const section = document.getElementById('federatedSection');
                if (section) {
                    section.hidden = true;
                    section.inert = true;
                    section.setAttribute('aria-hidden', 'true');
                }
                return;
            }
            function esc(v){ return String(v).replace(/[&<>"']/g, function(c){ return { '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c]; }); }
            function fmtNum(n){ if(n==null) return '—'; return Number(n).toLocaleString(); }
            function fmtUsd(n){ if(n==null) return '—'; return '$' + Number(n).toFixed(4); }
            function fmtUsdOrUnpriced(v){ return Number.isFinite(v) ? fmtUsd(v) : 'unpriced'; }
            // The federated route accepts fixed windows; "since daily use began"
            // uses the smallest one that covers it and says so.
            function federatedWindow(){
                const select = document.getElementById('analyticsWindow');
                const chosen = select && select.value || '24h';
                if (chosen !== 'usage') return { key: chosen, label: null };
                const since = Date.parse(select.dataset.usageSince || '');
                const days = Number.isFinite(since) ? (Date.now() - since) / 86400000 : 1;
                const key = days <= 1 ? '24h' : days <= 7 ? '7d' : days <= 30 ? '30d' : 'all';
                return { key, label: { '24h': 'last 24 h', '7d': 'last 7 days', '30d': 'last 30 days', all: 'all retained' }[key] };
            }
            let federatedSeq = 0;
            function showFederatedError(){
                ['fedMcSessions', 'fedMcTokens', 'fedMcSpend', 'fedMcAsOf'].forEach(function(id){
                    const el = document.getElementById(id);
                    if (el) el.textContent = '—';
                });
                document.getElementById('fedMcTableBody').innerHTML = '<tr><td colspan="5" class="wb-empty">Could not load provider telemetry. Try Refresh.</td></tr>';
            }
            async function loadFederated(){
                const win = federatedWindow();
                const seq = ++federatedSeq;
                document.getElementById('fedWindow').textContent = 'routed by AgentX' + (win.label ? ' · ' + win.label : '');
                let payload;
                try {
                    const r = await fetch('/api/analytics/federated?window=' + encodeURIComponent(win.key), { signal: AbortSignal.timeout(30000) });
                    if (!r.ok) throw new Error('Request failed: ' + r.status);
                    payload = await r.json();
                } catch(err){
                    if (seq !== federatedSeq) return;
                    console.error('Federated fetch failed', err);
                    showFederatedError();
                    return;
                }
                if (seq !== federatedSeq) return;
                document.getElementById('federatedMcBanner').style.display = payload.provider_status !== 'ok' ? 'block' : 'none';

                const provider = payload.providers;
                const mbody = document.getElementById('fedMcTableBody');
                const wrap = document.getElementById('fedMcTableWrap');
                if (provider && provider.totals){
                    document.getElementById('fedMcSessions').textContent = fmtNum(provider.totals.sessions);
                    document.getElementById('fedMcTokens').textContent = fmtNum(provider.totals.totalTokens);
                    document.getElementById('fedMcSpend').textContent = provider.totals.sessions ? fmtUsdOrUnpriced(provider.estimatedSpendUsd) : '$0';
                    document.getElementById('fedMcAsOf').textContent = provider.asOfMs ? new Date(provider.asOfMs).toLocaleString() : '—';
                    const rows = Array.isArray(provider.byModel) ? provider.byModel : [];
                    wrap.hidden = rows.length === 0;
                    mbody.innerHTML = rows.slice(0, 20).map(function(r){
                        return '<tr>' +
                            '<td>' + esc(r.model||'—') + '</td>' +
                            '<td>' + esc(r.provider||'—') + '</td>' +
                            '<td>' + fmtNum(r.sessions) + '</td>' +
                            '<td>' + fmtNum(r.totalTokens) + '</td>' +
                            '<td>' + fmtUsdOrUnpriced(r.estimatedSpendUsd) + '</td>' +
                            '</tr>';
                    }).join('');
                } else {
                    ['fedMcSessions', 'fedMcTokens', 'fedMcSpend', 'fedMcAsOf'].forEach(function(id){ document.getElementById(id).textContent = '—'; });
                    wrap.hidden = false;
                    mbody.innerHTML = '<tr><td colspan="5" class="wb-empty">Provider telemetry unavailable.</td></tr>';
                }
            }
            function loadFederatedWhenOpen(){
                const gate = window.AgentXAnalyticsCockpit && window.AgentXAnalyticsCockpit.whenOpen;
                return gate ? gate('federated', loadFederated) : loadFederated();
            }
            document.getElementById('federatedRefreshBtn').addEventListener('click', loadFederated);
            document.getElementById('analyticsWindow')?.addEventListener('change', loadFederatedWhenOpen);
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', loadFederatedWhenOpen);
            } else {
                loadFederatedWhenOpen();
            }
        })();
        </script>

          </div>
        </details>
    </main>
