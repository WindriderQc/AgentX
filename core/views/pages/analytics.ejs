        <div class="wb-subsection">
            <div class="wb-section-head">
                <h3><i class="fas fa-table" aria-hidden="true"></i> Cost efficiency by model</h3>
                <button type="button" id="efficiencyRefreshBtn" class="wb-button wb-button-quiet" aria-label="Refresh cost efficiency"><i class="fas fa-sync-alt"></i> Refresh</button>
            </div>
