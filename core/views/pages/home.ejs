<% const navigation = buildProductNavigation({ ...locals, service: 'core' }); const demo = locals.agentxProfile === 'demo'; %>
<main class="agentx-home">
  <section class="agentx-home__hero" aria-labelledby="home-title">
    <p class="agentx-home__eyebrow"><span aria-hidden="true"></span> <%= demo ? 'YOUR LOCAL AI WORKSPACE' : 'TON ÉCOSYSTÈME, À PORTÉE DE MAIN' %></p>
    <h1 id="home-title"><%= demo ? 'What do you want to do?' : 'À toi de jouer.' %></h1>
    <p class="agentx-home__lede"><%= demo ? 'Start a conversation, explore your documents, or compare models.' : 'Un espace pour toi. Un pour la famille. Un pour tes idées.' %></p>
  </section>
  <% if (demo) { %>
  <section class="agentx-home__tasks" aria-label="Start with Agent X">
    <a class="agentx-task-card agentx-task-card--primary" href="/playground">
      <span class="agentx-task-card__icon" aria-hidden="true"><i class="fas fa-message"></i></span>
      <span class="agentx-task-card__content">
        <span class="agentx-task-card__kicker">Chat</span>
        <strong>Start a conversation</strong>
        <small>Ask, write, analyze, or brainstorm. If chat is not ready, it names an installed model you can choose.</small>
      </span>
      <span class="agentx-task-card__action">Start <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
    </a>

    <a class="agentx-task-card" href="/playground?persona=learning_guide">
      <span class="agentx-task-card__icon" aria-hidden="true"><i class="fas fa-graduation-cap"></i></span>
      <span class="agentx-task-card__content">
        <span class="agentx-task-card__kicker">Persona</span>
        <strong>Try a guided conversation</strong>
        <small>Keep the decision visible while Learning Guide adapts the way Agent X explains.</small>
      </span>
      <span class="agentx-task-card__action">Try Learning Guide <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
    </a>

    <a class="agentx-task-card" href="<%= publicUrls.rag %>/upload">
      <span class="agentx-task-card__icon" aria-hidden="true"><i class="fas fa-file-lines"></i></span>
      <span class="agentx-task-card__content">
        <span class="agentx-task-card__kicker">Your documents</span>
        <strong>Use your own knowledge</strong>
        <small>Add a document, then ask questions grounded in its contents.</small>
      </span>
      <span class="agentx-task-card__action">Add a document <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
    </a>

    <a class="agentx-task-card" href="<%= publicUrls.benchmark %>/">
      <span class="agentx-task-card__icon" aria-hidden="true"><i class="fas fa-scale-balanced"></i></span>
      <span class="agentx-task-card__content">
        <span class="agentx-task-card__kicker">Model evidence</span>
        <strong>Compare models</strong>
        <small>See which models are faster, stronger, or more efficient on the same work.</small>
      </span>
      <span class="agentx-task-card__action">Open comparison <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
    </a>
  </section>

  <% } else { %>
  <section class="home-spaces" aria-label="Choisir un espace">
    <% navigation.spaces.forEach((space, index) => { %>
    <a class="home-space home-space--<%= space.id %>" href="<%= space.href %>">
      <span class="home-space__top"><span class="home-space__number">0<%= index + 1 %></span><i class="fas <%= space.icon %>" aria-hidden="true"></i></span>
      <span class="home-space__art" aria-hidden="true">
        <svg viewBox="0 0 240 100" fill="none">
          <% if (index === 0) { %>
          <ellipse cx="120" cy="50" rx="72" ry="29"/><ellipse cx="120" cy="50" rx="42" ry="42"/><circle cx="120" cy="50" r="16" class="art-fill"/><circle cx="189" cy="42" r="5" class="art-solid"/>
          <% } else if (index === 1) { %>
          <path d="M52 71L94 30L148 49L183 24M52 71L142 83L183 24M94 30L142 83"/><circle cx="52" cy="71" r="9" class="art-fill"/><circle cx="94" cy="30" r="13" class="art-fill"/><circle cx="148" cy="49" r="20" class="art-fill"/><circle cx="183" cy="24" r="7" class="art-solid"/><circle cx="142" cy="83" r="7" class="art-solid"/>
          <% } else { %>
          <path d="M48 66L108 16L167 66L108 94Z"/><path d="M76 65L135 15L194 65L135 94Z"/><path d="M108 16V94M135 15V94"/><path d="M115 36L105 57H124L114 77" class="art-bolt"/>
          <% } %>
        </svg>
      </span>
      <span class="home-space__copy"><strong><%= space.label %></strong><span><%= space.description %></span></span>
      <span class="home-space__arrow" aria-hidden="true">↗</span>
    </a>
    <% }); %>
  </section>
  <% } %>
  <div class="home-secondary">
    <% const hostHomePath = locals.hostHome
      ? (new URL(hostHome.url, 'http://agentx.invalid').pathname.replace(/\/+$/, '').toLowerCase() || '/') : null; %>
    <% if (locals.hostHome && !['/', '/portal', '/ecosystem'].includes(hostHomePath)) { %><a class="home-host-link" id="host-home-link" href="<%= hostHome.url %>"><%= hostHome.label || 'Back to host' %> ↗</a><% } %>
    <details class="home-tools" id="homeTools">
      <summary><span><%= demo ? 'All tools' : 'Tous les outils' %></span><i class="fas fa-plus" aria-hidden="true"></i></summary>
      <div class="home-tool-grid">
      <% navigation.navItems.forEach(group => { %>
        <section class="home-tool-group" aria-labelledby="home-<%= group.id %>">
          <h2 id="home-<%= group.id %>"><%= group.label %></h2>
          <ul>
          <% group.children.forEach(item => { %>
            <% if (item.section) { %><li class="home-tool-section"><%= item.section %></li>
            <% } else if (item.action) { %><li><button type="button" data-home-action="<%= item.action %>"><%= item.label %></button></li>
            <% } else { %><li><a href="<%= item.href %>" <% if (item.external) { %>target="_blank" rel="noopener"<% } %> <% if (item.description) { %>title="<%= item.description %>"<% } %>><%= item.label %><% if (item.owner) { %> <small><%= item.owner %></small><% } %></a></li><% } %>
          <% }); %>
          </ul>
        </section>
      <% }); %>
      </div>
    </details>
    <details class="home-tools home-health" id="homeHealth">
      <summary><span><%= demo ? 'System details' : 'État du système' %></span><small id="homeUpdated">—</small><i class="fas fa-plus" aria-hidden="true"></i></summary>
      <div class="agentx-home__readiness" id="homeReadiness" data-state="loading" role="status" aria-live="polite">
        <span class="agentx-home__readiness-icon" aria-hidden="true"><i class="fas fa-circle-notch"></i></span>
        <span class="agentx-home__readiness-copy"><strong id="homeReadinessLabel">État non observé</strong><small id="homeReadinessDetail">Ouvre ce panneau pour vérifier les services.</small></span>
        <button id="homeStatusRefresh" type="button" aria-label="Refresh Agent X readiness"><i class="fas fa-rotate" aria-hidden="true"></i><span>Actualiser</span></button>
      </div>
      <p>Core, Benchmark, and RAG HTTP contracts, required dependency health, and deployment consistency.</p>
      <ul id="homeServiceDetails"></ul><p id="homeConsistency"></p>
    </details>
  </div>
</main>
