<main class="finance-page" id="main-content">
  <header class="finance-header">
    <div class="finance-title-row">
      <h1>Wallet Beefer</h1>
      <nav class="finance-ledger-switch" aria-label="Ledger">
        <a href="/finance" id="ledgerPerso">Personal</a>
        <a href="/finance?ledger=corp" id="ledgerCorp">Corporation</a>
      </nav>
    </div>
    <p class="finance-phase" id="financePhase"></p>
    <p class="finance-sub" id="financeCoverage">Ledger reconciled to the cent · loading…</p>
  </header>

  <p class="finance-error" id="financeError" role="alert" hidden></p>

  <section class="finance-card finance-alerts finance-perso-only" id="financeAlertsCard" aria-labelledby="alertsTitle" hidden>
    <h2 id="alertsTitle">Alerts</h2>
    <ul class="finance-alert-list" id="financeAlerts"></ul>
  </section>

  <section class="finance-perso-only" aria-labelledby="situationTitle">
    <h2 id="situationTitle">My situation</h2>
    <div class="finance-tiles finance-tiles-wide" id="financeSituation"></div>
    <p class="finance-note" id="financeSituationNote"></p>
  </section>

  <section class="finance-card finance-perso-only" aria-labelledby="netTitle">
    <div class="finance-card-head">
      <h2 id="netTitle">Net balance per month</h2>
      <p class="finance-note" id="financeNetNote"></p>
    </div>
    <div class="finance-chart"><canvas id="netChart" aria-label="Net balance per month" role="img"></canvas></div>
  </section>

  <section class="finance-card finance-perso-only" id="financeOpenCard" aria-labelledby="openTitle" hidden>
    <h2 id="openTitle">What remains — open items</h2>
    <ol class="finance-open" id="financeOpen"></ol>
  </section>

  <section class="finance-card finance-perso-only" id="financeAllocCard" aria-labelledby="allocTitle" hidden>
    <h2 id="allocTitle">Cash allocation — plan</h2>
    <div class="finance-table-scroll" role="region" aria-label="Cash allocation, horizontal scroll" tabindex="0">
      <table class="finance-table finance-wide" id="financeAlloc">
        <thead><tr><th>Step</th><th class="num">Amount</th><th>Status / effect</th></tr></thead>
        <tbody></tbody>
      </table>
    </div>
  </section>

  <section class="finance-card finance-perso-only" id="financeDebtsCard" aria-labelledby="debtsTitle" hidden>
    <h2 id="debtsTitle">Active debts</h2>
    <div class="finance-table-scroll" role="region" aria-label="Active debts, horizontal scroll" tabindex="0">
      <table class="finance-table finance-wide" id="financeDebts">
        <thead><tr><th>Debt</th><th class="num">Balance</th><th class="num">Rate</th><th class="num">Payment</th><th>Status</th></tr></thead>
        <tbody></tbody>
      </table>
    </div>
  </section>

  <section class="finance-card finance-perso-only" id="financeCreditCard" aria-labelledby="creditTitle" hidden>
    <h2 id="creditTitle">Available credit — the relapse risk</h2>
    <div class="finance-table-scroll" role="region" aria-label="Available credit, horizontal scroll" tabindex="0">
      <table class="finance-table finance-wide" id="financeCredit">
        <thead><tr><th>Account</th><th class="num">Limit</th><th class="num">Used</th><th class="num">Available</th><th>Status</th></tr></thead>
        <tbody></tbody>
      </table>
    </div>
  </section>

  <section class="finance-card finance-perso-only" id="financeWatchCard" aria-labelledby="watchTitle" hidden>
    <h2 id="watchTitle">Watch — upcoming deadlines</h2>
    <div class="finance-table-scroll" role="region" aria-label="Upcoming deadlines, horizontal scroll" tabindex="0">
      <table class="finance-table finance-wide" id="financeWatch">
        <thead><tr><th>Date</th><th>What</th><th>Status</th></tr></thead>
        <tbody></tbody>
      </table>
    </div>
  </section>

  <section class="finance-card finance-perso-only" id="financeBudgetCard" aria-labelledby="budgetTitle" hidden>
    <div class="finance-card-head">
      <h2 id="budgetTitle">Where the money goes — actual vs budget</h2>
      <p class="finance-note" id="financeBudgetNote"></p>
    </div>
    <div class="finance-table-scroll" role="region" aria-label="Budget, horizontal scroll" tabindex="0">
      <table class="finance-table finance-wide finance-budget" id="financeBudget">
        <thead><tr><th>Line</th><th class="num">Budget / month</th><th class="num">Actual / month</th><th class="num">Gap</th><th class="finance-budget-bar-col">Actual vs budget</th></tr></thead>
        <tbody></tbody>
      </table>
    </div>
  </section>

  <section class="finance-card finance-perso-only" id="financeProvisionsCard" aria-labelledby="provisionsTitle" hidden>
    <div class="finance-card-head">
      <h2 id="provisionsTitle">Annual expenses — to set aside</h2>
      <p class="finance-note" id="financeProvisionsNote"></p>
    </div>
    <div class="finance-table-scroll" role="region" aria-label="Annual expenses, horizontal scroll" tabindex="0">
      <table class="finance-table finance-wide" id="financeProvisions">
        <thead><tr><th>Expense</th><th class="num">Annual</th><th class="num">Per month</th><th>Due / note</th></tr></thead>
        <tbody></tbody>
      </table>
    </div>
  </section>

  <section class="finance-card finance-perso-only" aria-labelledby="debtSimTitle">
    <h2 id="debtSimTitle">Net debt — trajectory under a scenario</h2>
    <form class="finance-filters finance-sim-form" id="debtForm">
      <label>Extra payment / month ($) <input type="text" inputmode="decimal" id="simExtra" value="0"></label>
      <label>Lump sum ($) <input type="text" inputmode="decimal" id="simLump" value="0"></label>
      <label>… paid in month no. <input type="number" id="simLumpMonth" value="1" min="1" max="360"></label>
      <label>Annual bonus in December ($) <input type="text" inputmode="decimal" id="simBonus" value="0"></label>
      <label>Horizon (years) <input type="number" id="simYears" value="6" min="1" max="30"></label>
      <button type="submit" class="finance-button">Simulate</button>
    </form>
    <div class="finance-chart finance-chart-tall"><canvas id="debtChart" aria-label="Debt trajectory" role="img"></canvas></div>
    <ul class="finance-result" id="debtResult"></ul>
    <p class="finance-note">Amortizing debts from the plan (known rate and payment), balances taken from the ledger. Surplus money goes to
      the highest-rate debt first (avalanche); a paid-off debt frees its payment for the others.</p>
  </section>

  <section class="finance-card finance-perso-only" aria-labelledby="forecastTitle">
    <h2 id="forecastTitle">Cash-flow forecast — 12 months</h2>
    <form class="finance-filters finance-sim-form" id="forecastForm">
      <label>Income / month ($) <input type="text" inputmode="decimal" id="fcIncome" placeholder="budget"></label>
      <label>Expenses / month ($) <input type="text" inputmode="decimal" id="fcSpend" placeholder="budget"></label>
      <label>Target cushion ($) <input type="text" inputmode="decimal" id="fcCushion" value="15000"></label>
      <label class="finance-check"><input type="checkbox" id="fcProvisions" checked> Set aside provisions</label>
      <label class="finance-wide-label">One-off events, one per line: <code>YYYY-MM ; amount ; label</code> (negative = outflow)
        <textarea id="fcEvents" rows="3" placeholder="2026-12 ; 6000 ; work bonus&#10;2027-02 ; -26000 ; RRSP contribution"></textarea></label>
      <button type="submit" class="finance-button">Recalculate</button>
    </form>
    <div class="finance-chart finance-chart-tall"><canvas id="forecastChart" aria-label="Cash forecast" role="img"></canvas></div>
    <p class="finance-note" id="forecastNote"></p>
    <details>
      <summary>Show table</summary>
      <div class="finance-table-scroll" role="region" aria-label="Cash forecast, horizontal scroll" tabindex="0">
        <table class="finance-table finance-wide" id="forecastTable">
          <thead><tr><th>Month</th><th class="num">Income</th><th class="num">Expenses + provisions</th><th class="num">One-off</th><th class="num">Month-end cash</th></tr></thead>
          <tbody></tbody>
        </table>
      </div>
    </details>
  </section>

  <section class="finance-card" aria-labelledby="historyTitle">
    <div class="finance-card-head">
      <h2 id="historyTitle">Trajectories — account balances across statements</h2>
      <label class="finance-inline-label">Show <select id="histKind">
        <option value="debt">debts and cards</option><option value="cash">checking account</option><option value="all">all</option>
      </select></label>
    </div>
    <div class="finance-chart finance-chart-tall"><canvas id="historyChart" aria-label="Balances across statements" role="img"></canvas></div>
    <p class="finance-note" id="historyNote">Closing balance of each reconciled statement; a gap = missing statement.</p>
  </section>

  <section class="finance-card" aria-labelledby="catMonthsTitle">
    <div class="finance-card-head">
      <h2 id="catMonthsTitle">Spending by category, month by month</h2>
      <label class="finance-inline-label">Period <select id="catMonths">
        <option value="12">12 months</option><option value="24">24 months</option><option value="60">5 years</option>
      </select></label>
    </div>
    <div class="finance-chart finance-chart-tall"><canvas id="categoryMonthsChart" aria-label="Spending by category and month" role="img"></canvas></div>
    <p class="finance-note" id="categoryMonthsNote">Internal transfers excluded; categories beyond the top 7 are grouped.</p>
  </section>

  <details class="finance-card finance-perso-only" id="financeMilestonesCard" hidden>
    <summary><h2 class="finance-inline">What has been settled</h2></summary>
    <ul class="finance-checklist" id="financeDone"></ul>
  </details>

  <section aria-labelledby="balancesTitle">
    <h2 id="balancesTitle">Account balances (latest statement)</h2>
    <div class="finance-tiles" id="financeBalances"></div>
  </section>

  <section class="finance-card finance-analysis" aria-labelledby="analysisTitle">
    <h2 id="analysisTitle">History analysis</h2>
    <p class="finance-note">These filters apply to the whole analysis below: chart, categories, spending, search,
      yearly totals and export.</p>
    <div class="finance-filters" role="group" aria-label="Analysis filters">
      <label>Account <select id="financeAccount"><option value="">All accounts</option></select></label>
      <label>From <input type="date" id="financeFrom"></label>
      <label>To <input type="date" id="financeTo"></label>
      <label>Category <select id="financeCategory"><option value="">All</option></select></label>
      <label>Tag <select id="financeTag"><option value="">None</option></select></label>
      <label class="finance-check"><input type="checkbox" id="financeExcludeTransfers" checked> Exclude internal transfers</label>
    </div>
    <p class="finance-note finance-help">A <strong>tag</strong> is a label a rule puts on transactions:
      a person (<code>nathalie</code>, <code>olivier</code>), an activity (<code>karate</code>) or a use
      (<code>partageable</code>). Choosing a tag shows only those transactions.</p>
  </section>

  <section class="finance-card" aria-labelledby="monthlyTitle">
    <div class="finance-card-head">
      <h2 id="monthlyTitle">Money in and out per month</h2>
      <p class="finance-note" id="monthlyNote"></p>
    </div>
    <div class="finance-legend" aria-hidden="true">
      <span><i class="swatch swatch-in"></i>In</span>
      <span><i class="swatch swatch-out"></i>Out</span>
    </div>
    <div class="finance-chart"><canvas id="monthlyChart" aria-label="Money in and out per month" role="img"></canvas></div>
    <details>
      <summary>Show table</summary>
      <table class="finance-table" id="monthlyTable">
        <thead><tr><th>Month</th><th class="num">In</th><th class="num">Out</th><th class="num">Net</th><th class="num">Transactions</th></tr></thead>
        <tbody></tbody>
      </table>
    </details>
  </section>

  <section class="finance-card" aria-labelledby="categoriesTitle">
    <h2 id="categoriesTitle">Spending by category</h2>
    <ol class="finance-bars" id="financeCategories"></ol>
    <p class="finance-note" id="financeUncategorized"></p>
  </section>

  <section class="finance-card" aria-labelledby="merchantsTitle">
    <h2 id="merchantsTitle">Largest spending by merchant</h2>
    <ol class="finance-bars" id="financeMerchants"></ol>
  </section>

  <section class="finance-card" aria-labelledby="searchTitle">
    <h2 id="searchTitle">How much at…</h2>
    <form class="finance-search" id="financeSearch">
      <input type="search" id="financeQuery" placeholder="Costco, dojo, Hydro…" maxlength="80" aria-label="Merchant or description">
      <button type="submit">Search</button>
    </form>
    <div class="finance-search-result" id="financeSearchResult" aria-live="polite"></div>
    <p class="finance-note"><a id="financeExport" href="/api/finance/export.csv" download>Export as CSV (Excel)</a> — follows the filters and the search.</p>
  </section>

  <section class="finance-card" aria-labelledby="yearlyTitle">
    <h2 id="yearlyTitle">Yearly totals</h2>
    <p class="finance-note">Follows the analysis filters and the search: for example the tag <code>nathalie</code> gives what
      was sent and received each year.</p>
    <div class="finance-table-scroll" role="region" aria-label="Yearly totals, horizontal scroll" tabindex="0">
      <table class="finance-table finance-wide" id="yearlyTable">
        <thead><tr><th>Year</th><th class="num">In</th><th class="num">Out</th><th class="num">Net</th><th class="num">Transactions</th><th>Coverage</th></tr></thead>
        <tbody></tbody>
      </table>
    </div>
  </section>

  <section class="finance-card" aria-labelledby="classifyTitle">
    <div class="finance-card-head">
      <h2 id="classifyTitle">To categorize</h2>
      <button type="button" class="finance-button" id="financeSuggest">Suggest categories</button>
    </div>
    <p class="finance-note">The local model suggests a category for the heaviest descriptions. Correct as needed,
      check what is right, then save: each row becomes a rule applied to the whole history.</p>
    <div id="financeSuggestStatus" class="finance-note" aria-live="polite"></div>
    <table class="finance-table finance-classify" id="financeSuggestTable" hidden>
      <thead><tr><th>✓</th><th>Description</th><th class="num">Count</th><th class="num">Total</th><th>Category</th><th>Tags</th><th>Confidence</th></tr></thead>
      <tbody></tbody>
    </table>
    <button type="button" class="finance-button" id="financeSaveRules" hidden>Save checked rules</button>
  </section>

  <section class="finance-card" aria-labelledby="statementsTitle">
    <h2 id="statementsTitle">Statements</h2>
    <h3 class="finance-subtitle">Coverage and missing months</h3>
    <ul class="finance-coverage" id="financeCoverageList"></ul>
    <details>
      <summary>All statements</summary>
      <table class="finance-table" id="statementsTable">
        <thead><tr><th>Statement</th><th>Period</th><th>Accounts</th><th>Status</th></tr></thead>
        <tbody></tbody>
      </table>
    </details>
    <p class="finance-note">Drop a PDF statement in the Finance inbox: it is read, checked to the cent, then archived (checked every 15 minutes).</p>
  </section>
</main>
