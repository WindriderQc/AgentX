<details id="image-protected-composition" class="image-protected" hidden>
  <summary>Keep the parent outside the chosen zones</summary>
  <p>Choose the rectangles where the edit result is taken. The composition keeps the parent’s pixels everywhere else. Both images must have the same dimensions.</p>
  <button id="image-protected-prepare" type="button" class="quiet-button">Prepare the zones on the parent</button>
  <p id="image-protected-status" role="status"></p>
  <div id="image-protected-workspace" hidden>
    <p class="image-help">Draw a rectangle on the parent, or enter its coordinates in pixels. The blue zones will receive the result.</p>
    <canvas id="image-protected-canvas" aria-label="Parent and replacement zones"></canvas>
    <fieldset id="image-protected-fields">
      <legend>Zone to add</legend>
      <label for="image-protected-x">X<input id="image-protected-x" type="number" min="0" step="1" value="0"></label>
      <label for="image-protected-y">Y<input id="image-protected-y" type="number" min="0" step="1" value="0"></label>
      <label for="image-protected-width">Width<input id="image-protected-width" type="number" min="1" step="1" value="1"></label>
      <label for="image-protected-height">Height<input id="image-protected-height" type="number" min="1" step="1" value="1"></label>
      <button id="image-protected-add" type="button" class="quiet-button">Add this zone</button>
    </fieldset>
    <ol id="image-protected-regions"></ol>
    <button id="image-protected-build" type="button" class="quiet-button">Compose and verify the kept pixels</button>
    <div id="image-protected-downloads" hidden>
      <a id="image-protected-png" class="quiet-button" download="protected-composition.png">Download the PNG composition</a>
      <a id="image-protected-receipt" class="quiet-button" download="protected-composition.json">Download the zones and the receipt</a>
      <img id="image-protected-output" alt="Composition with the parent’s pixels kept outside the chosen zones">
    </div>
  </div>
</details>
