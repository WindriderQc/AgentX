<main class="pipeline-page">
  <header class="pipeline-hero">
    <div class="pipeline-hero-copy">
      <div class="pipeline-eyebrow"><i class="fas fa-code"></i> Engineering workspace</div>
      <h1>Coding &amp; delivery pipeline</h1>
      <p>
        Follow technical work by the Coding Team and human operators,
        from preparation through review and production delivery.
      </p>
      <p>Personal tasks stay in My day; family tasks stay in Family tracking.
        They are excluded from this overview, its counts and its closed-task history.</p>
      <div class="pipeline-hero-actions">
        <button id="pipelineNewTask" class="pipeline-btn primary" type="button"><i class="fas fa-plus" aria-hidden="true"></i><span>New task</span></button>
        <button id="pipelineRefreshBtn" class="pipeline-btn" type="button">
          <i class="fas fa-rotate"></i><span>Refresh</span>
        </button>
        <button id="pipelineAutoBtn" class="pipeline-btn" type="button" aria-pressed="false"
          title="Automatically refresh the queue every 60 seconds">
          <i class="fas fa-clock-rotate-left"></i><span>Auto-refresh</span>
        </button>
        <a class="pipeline-btn" href="/agent-ops">
          <i class="fas fa-circle-nodes"></i><span>Agent Ops</span>
        </a>
        <a class="pipeline-btn" href="/dad/day"><i class="fas fa-calendar-day" aria-hidden="true"></i><span>My personal tasks</span></a>
        <a class="pipeline-btn" href="/dad/family"><i class="fas fa-house" aria-hidden="true"></i><span>Family tracking</span></a>
        <button class="cockpit-help-button" type="button" data-cockpit-guide-open="pipelineGuide">
          <i class="fas fa-circle-question"></i><span>Page guide</span>
        </button>
      </div>
    </div>
    <aside class="pipeline-lifecycle" aria-label="Task lifecycle">
      <div class="pipeline-lifecycle-title"><i class="fas fa-route"></i> One task contract</div>
      <ol class="pipeline-lifecycle-flow">
        <li class="stage-queued" data-cockpit-tip-title="Queued" data-cockpit-tip="Ready for any worker to claim atomically. Re-queueing a task releases its worker and heartbeat." tabindex="0"><i class="fas fa-inbox"></i><span>Queued</span></li>
        <li class="stage-progress" data-cockpit-tip-title="In progress" data-cockpit-tip="Claimed by a worker. Healthy work heartbeats regularly; a silent hour marks it stale." tabindex="0"><i class="fas fa-bolt"></i><span>In progress</span></li>
        <li class="stage-review" data-cockpit-tip-title="Review" data-cockpit-tip="Human review is required. Current Coding Team attempts carry a receipt; legacy dossiers may not. Workers never self-certify." tabindex="0"><i class="fas fa-magnifying-glass"></i><span>Review</span></li>
        <li class="stage-done" data-cockpit-tip-title="Done" data-cockpit-tip="Confirmed by a human identity distinct from the worker. Every confirmation lands in the audit trail." tabindex="0"><i class="fas fa-check"></i><span>Done</span></li>
      </ol>
      <div class="pipeline-lifecycle-branch" data-cockpit-tip-title="Blocked" data-cockpit-tip="Any stage can report blocked. Blocked work needs an operator or upstream action before it can move." tabindex="0">
        <i class="fas fa-hand"></i><span>Blocked &mdash; needs intervention</span>
      </div>
      <span class="pipeline-lifecycle-api">Done records task closure. Merge and production proof are separate.</span>
    </aside>
  </header>

  <section id="pipelineHandoffContext" class="pipeline-context" aria-live="polite" hidden>
    <span class="pipeline-context-icon"><i class="fas fa-crosshairs"></i></span>
    <div>
      <strong id="pipelineContextTitle">Context from Agent Ops</strong>
      <span id="pipelineContextDetail">The task list is focused without changing pipeline truth.</span>
    </div>
    <a href="/pipeline" title="Remove the Agent Ops context and show the full pipeline"><i class="fas fa-xmark"></i> Clear context</a>
  </section>

  <nav class="pipeline-section-nav" aria-label="Pipeline sections"><a href="#pipelineOverview">Overview</a><a href="#pipelinePrepare">Prepare and launch</a><a href="#pipelineFollow">Follow and decide</a><a href="#pipelineHistory">History and performance</a></nav>

  <section class="pipeline-state" id="pipelineState" data-tone="loading" aria-live="polite">
    <div>
      <i class="fas fa-spinner fa-spin" id="pipelineStateIcon" aria-hidden="true"></i>
      <a id="pipelineStateTitle" class="pipeline-state-title">Loading the pipeline&hellip;</a>
      <span id="pipelineStateDetail">Reading the product-owned task queue.</span>
      <a id="pipelineStateAction" class="pipeline-btn compact" href="#pipelineAttention" hidden>View tasks needing attention <i class="fas fa-arrow-down" aria-hidden="true"></i></a>
    </div>
    <time id="pipelineStateUpdated"></time>
  </section>

  <section class="pipeline-metrics" aria-label="All-time engineering task counts with the selected archive visibility — select one to filter the progression below">
    <button class="pipeline-metric metric-queued" type="button" data-status-filter="queued" aria-pressed="false">
      <span><i class="fas fa-inbox" aria-hidden="true"></i> Queued</span>
      <strong id="pipelineCountQueued">--</strong>
      <small>Waiting for preparation or a worker</small>
    </button>
    <button class="pipeline-metric metric-progress" type="button" data-status-filter="in_progress" aria-pressed="false">
      <span><i class="fas fa-bolt" aria-hidden="true"></i> In progress</span>
      <strong id="pipelineCountProgress">--</strong>
      <small>Claimed and actively moving</small>
    </button>
    <button class="pipeline-metric metric-review" type="button" data-status-filter="review" aria-pressed="false">
      <span><i class="fas fa-magnifying-glass" aria-hidden="true"></i> Review</span>
      <strong id="pipelineCountReview">--</strong>
      <small>Human review required; receipt status shown in dossier</small>
    </button>
    <button class="pipeline-metric metric-blocked" type="button" data-status-filter="blocked" aria-pressed="false">
      <span><i class="fas fa-hand" aria-hidden="true"></i> Blocked</span>
      <strong id="pipelineCountBlocked">--</strong>
      <small>Needs operator or upstream action</small>
    </button>
    <button class="pipeline-metric metric-done" type="button" data-status-filter="done" aria-pressed="false">
      <span><i class="fas fa-check" aria-hidden="true"></i> Closed</span>
      <strong id="pipelineCountDone">--</strong>
      <small>Recorded closures, including superseded tasks</small>
    </button>
  </section>

  <p id="pipelineCountEvidence" class="pipeline-count-evidence" aria-live="polite">
    Loading count scope and observation evidence&hellip;
  </p>

  <section class="pipeline-panel pipeline-overview" id="pipelineOverview" aria-labelledby="pipelineOverviewTitle">
    <div class="pipeline-panel-header">
      <div><h2 id="pipelineOverviewTitle"><i class="fas fa-diagram-project"></i> Work at a glance</h2><p>Follow tasks in their current stage. Select a card to open its dossier.</p></div>
      <div class="pipeline-view-switch" role="group" aria-label="Task progression view">
        <button class="pipeline-btn compact active" type="button" data-pipeline-view="board" aria-pressed="true"><i class="fas fa-table-columns" aria-hidden="true"></i> Board</button>
        <button class="pipeline-btn compact" type="button" data-pipeline-view="timeline" aria-pressed="false"><i class="fas fa-clock-rotate-left" aria-hidden="true"></i> Timeline</button>
      </div>
    </div>
    <div class="pipeline-toolbar">
      <div class="pipeline-search">
        <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
        <input id="pipelineSearch" type="search" placeholder="Search id, title, owner, epic, source&hellip;"
          aria-label="Search tasks by id, title, owner, epic, or source" autocomplete="off">
      </div>
      <label class="pipeline-select">
        <span>Service</span>
        <select id="pipelineServiceFilter" aria-label="Filter by service">
          <option value="">All services</option>
        </select>
      </label>
      <label class="pipeline-select">
        <span>Lane / source</span>
        <select id="pipelineLaneFilter" aria-label="Filter by lane or source">
          <option value="">All lanes / sources</option>
        </select>
      </label>
      <label class="pipeline-select">
        <span>Sort</span>
        <select id="pipelineSort" aria-label="Sort the work table">
          <option value="urgency">Urgency</option>
          <option value="priority">Priority</option>
          <option value="recent">Recently updated</option>
          <option value="id">Task id</option>
        </select>
      </label>
      <label class="pipeline-select pipeline-group-select"><span>Task group / epic</span><select id="pipelineEpicFilter" aria-label="Filter by task group or epic"><option value="">All groups</option></select></label>
      <button id="pipelineClearFilters" class="pipeline-btn compact" type="button" hidden>
        <i class="fas fa-filter-circle-xmark"></i><span>Clear filters</span>
      </button>

    </div>

    <div class="pipeline-overview-scope"><p id="pipelineOverviewMeta" aria-live="polite">Loading progression&hellip;</p><label><input id="pipelineIncludeDone" type="checkbox" checked> Include done</label><label><input id="pipelineIncludeArchivedQualifications" type="checkbox"> Include archived qualifications</label></div>
    <div id="pipelineProgression" class="pipeline-progression" tabindex="-1" aria-label="Filtered task progression"><div class="pipeline-empty">Reading the task queue&hellip;</div></div>
  </section>

  <section class="pipeline-panel pipeline-workbench" id="pipelinePrepare" aria-labelledby="pipelinePrepareTitle">
    <div class="pipeline-panel-header"><div><h2 id="pipelinePrepareTitle"><i class="fas fa-list-check" aria-hidden="true"></i> Prepare and launch</h2><p>Open a task to review its scope, then choose how to run it.</p></div><button class="pipeline-btn compact" type="button" data-pipeline-new-task><i class="fas fa-plus" aria-hidden="true"></i> New task</button></div>
    <div class="pipeline-run-options">
    <div class="pipeline-team-launch" aria-labelledby="pipelineTeamLaunchTitle">
      <div class="pipeline-team-launch-copy">
        <span class="pipeline-run-label">Manual launch</span>
        <h3 id="pipelineTeamLaunchTitle">Run one task</h3>
        <p>Starts one bounded local worker. It stops at review or blocked; scheduling, merge, and deploy stay off.</p>
      </div>
      <p id="pipelineTeamLaunchAvailability" class="pipeline-launch-availability" data-tone="loading" role="status">Checking launch availability&hellip;</p>
      <form id="pipelineTeamLaunchForm" class="pipeline-team-launch-form">
        <label class="pipeline-team-launch-task">
          <span>Task to run</span>
          <select id="pipelineTeamLaunchTask" aria-label="Choose one queued coding candidate" aria-describedby="pipelineTeamAdmissionDetail" disabled>
            <option value="">No candidate loaded</option>
          </select>
        </label>
        <button id="pipelineTeamLaunchSelection" class="pipeline-btn compact" type="button" hidden>Review selected task</button>
        <label class="pipeline-team-launch-confirm">
          <input id="pipelineTeamLaunchConfirm" type="checkbox" disabled>
          <span>I have reviewed this task and approve one local run.</span>
        </label>
        <button id="pipelineTeamLaunchButton" class="pipeline-btn primary compact" type="submit" disabled>
          <i class="fas fa-play" aria-hidden="true"></i><span>Run one task</span>
        </button>
      </form>
      <div class="pipeline-launch-footer"><a href="#pipelineExecution">View live execution <i class="fas fa-arrow-right" aria-hidden="true"></i></a><span>Progress and stop controls are in Follow and decide.</span></div>
      <details id="pipelineTeamEligibility" class="pipeline-launch-eligibility">
        <summary>Which tasks can run here?</summary>
        <p id="pipelineTeamAdmissionDetail">The host checks task status, ownership, coding service and private lane before launch.</p>
        <div id="pipelineTeamEligibilityReasons">Reading the host admission rules…</div>
      </details>
    </div>
    <aside class="pipeline-run-alternative" aria-labelledby="pipelineAutonomyOptionTitle">
      <span class="pipeline-run-label">Optional automation</span>
      <h3 id="pipelineAutonomyOptionTitle">Run with automatic corrections</h3>
      <p>The Coding Team works within approved files and budgets, observes CI and can correct the draft PR.</p>
      <p>Requires a reviewed task and a reserved campaign window.</p>
      <a class="pipeline-btn compact" href="#pipelineCodingAutonomy">Manage Coding Team autonomy <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
      <span class="pipeline-subtle">Human review, merge and deployment remain separate decisions.</span>
    </aside>
    </div>
    <div class="pipeline-queue-heading"><div><h3>Task queue</h3><p>Uses the filters in Work at a glance. Select a row to edit scope, dependencies or feedback.</p></div><a href="#pipelineOverview">Change filters</a></div>
    <details class="pipeline-queue-coverage"><summary>Queue totals and coverage</summary><p class="pipeline-toolbar-meta pipeline-work-scope" id="pipelineOpenMeta" aria-live="polite">Loading task status&hellip;</p></details>
    <div class="pipeline-table-wrap">
      <table class="pipeline-table">
        <thead>
          <tr>
            <th scope="col">ID</th>
            <th scope="col">Task</th>
            <th scope="col">Priority</th>
            <th scope="col">Status</th>
            <th scope="col">Owner</th>
            <th scope="col">Service</th>
            <th scope="col">Due</th>
            <th scope="col">Activity</th>
          </tr>
        </thead>
        <tbody id="pipelineOpenRows">
          <tr><td colspan="8" class="pipeline-empty">Loading tasks&hellip;</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="pipeline-follow" id="pipelineFollow" aria-labelledby="pipelineFollowTitle">
    <div class="pipeline-section-heading"><div><h2 id="pipelineFollowTitle">Follow and decide</h2><p>Live execution, Coding Team controls and decisions that need your attention.</p></div></div>
    <section class="pipeline-panel pipeline-execution" id="pipelineExecution" aria-labelledby="pipelineExecutionTitle" tabindex="-1">
      <div class="pipeline-panel-header"><div><span class="pipeline-run-label">Manual run · live tracking</span><h3 id="pipelineExecutionTitle">Execution monitor</h3><p>Updates automatically while a request is active.</p></div><a class="pipeline-btn compact" href="#pipelinePrepare">Back to launch</a></div>
      <div class="pipeline-execution-body pipeline-worker-monitor" id="pipelineWorkerMonitor">
        <p id="pipelineTeamLaunchState" data-tone="loading" role="status" aria-live="polite">Checking the current execution&hellip;</p>
        <%- include('../partials/pipeline-worker-monitor') %>
        <details class="pipeline-execution-details"><summary>Request and worker details</summary>
          <p id="pipelineTeamLaunchDetail" class="pipeline-team-launch-detail">The host checks task status, ownership, coding service and private lane before launch.</p>
          <div id="pipelineTeamLaunchResult" class="pipeline-launch-result" hidden></div>
        </details>
        <div class="pipeline-launch-recovery">
          <button id="pipelineTeamLaunchRefresh" class="pipeline-btn compact" type="button">Refresh execution</button>
          <button id="pipelineTeamLaunchRetry" class="pipeline-btn compact" type="button" hidden>Retry the same request</button>
        </div>
      </div>
    </section>
    <%- include('../partials/pipeline-coding-autonomy') %>
    <div class="pipeline-follow-grid">
    <section class="pipeline-panel" id="pipelineAttention" tabindex="-1" aria-labelledby="pipelineAttentionTitle">
      <div class="pipeline-panel-header">
        <div>
          <h3 id="pipelineAttentionTitle"><i class="fas fa-triangle-exclamation" aria-hidden="true"></i> Needs attention</h3>
          <p>Task blockers, reviews and overdue work. Uses the overview filters.</p>
          <p id="pipelineAttentionSummary" class="pipeline-decision-total">Reading task decisions&hellip;</p>
        </div>
        <div id="pipelineAttentionScopes" class="pipeline-attention-scopes" role="group" aria-label="Attention queue">
          <span class="pipeline-chip">Engineering tasks</span>
        </div>
      </div>
      <p id="pipelineAttentionNotes" class="pipeline-attention-notes" hidden></p>
      <div id="pipelineAttentionLive" class="pipeline-attention-live" role="status" aria-live="polite"></div>
      <div id="pipelineAttentionList" class="pipeline-attention-list" aria-busy="true">
        <div class="pipeline-empty">Loading attention items&hellip;</div>
      </div>
      <nav id="pipelineAttentionPager" class="pipeline-attention-pager" aria-label="Attention pages" hidden></nav>
      <details class="pipeline-decision-coverage"><summary>Task queue scope and counts</summary><p id="pipelineAttentionMeta">--</p><p>This queue contains engineering tasks. Delivery reviews below have their own scope and can include the same task.</p></details>
    </section>

  <section class="pipeline-panel pipeline-delivery" id="pipelineDeliveryInbox" aria-labelledby="pipelineDeliveryTitle">
    <div class="pipeline-panel-header pipeline-delivery-header">
      <div>
        <span class="pipeline-delivery-eyebrow"><i class="fas fa-code-pull-request" aria-hidden="true"></i> Coding Team · recent deliveries</span>
        <h3 id="pipelineDeliveryTitle" tabindex="-1">Reviews and delivery</h3>
        <p>Review results, follow CI and decide when a verified PR can merge. Recent-task snapshot, independent of the overview filters.</p>
      </div>
      <span class="pipeline-delivery-count" id="pipelineDeliveryHumanCount" aria-label="Delivery decisions pending">--</span>
    </div>
    <div class="pipeline-delivery-state" id="pipelineDeliveryState" data-tone="loading" aria-live="polite">
      <i class="fas fa-spinner fa-spin" aria-hidden="true"></i>
      <span>Loading exact delivery evidence&hellip;</span>
    </div>
    <div id="pipelineDeliveryViews" class="pipeline-delivery-views" role="group" aria-label="Filter deliveries"></div>
    <div class="pipeline-delivery-list" id="pipelineDeliveryList" aria-label="Active delivery evidence">
      <div class="pipeline-empty">Reading accepted attempts, PRs, CI, and deployment proof&hellip;</div>
    </div>
    <nav id="pipelineDeliveryPager" class="pipeline-delivery-pager" aria-label="Delivery pages" hidden></nav>
    <p class="pipeline-delivery-note" id="pipelineDeliveryMeta">
      Merge always requires one explicit operator click. Deployment remains a separate protected workflow after merge.
    </p>
    <div class="pipeline-delivery-refresh"><button type="button" class="pipeline-btn compact" data-retry-delivery><i class="fas fa-rotate" aria-hidden="true"></i> Refresh deliveries</button><a href="#pipelineHistory">Completed deliveries in History <i class="fas fa-arrow-right" aria-hidden="true"></i></a></div>
  </section>

  </div>
  <details id="pipelineStallDiagnosis" class="pipeline-panel pipeline-stall">
    <summary><span>Why tasks are not advancing<small>Optional diagnosis · all active engineering tasks · independent of overview filters</small></span></summary>
    <p class="pipeline-muted">Inspect the owner, next step and missing evidence for a stalled task. These diagnostic counts can overlap the decision lists above. An expired lease or an old heartbeat does not prove a worker stopped. Nothing here repairs a task.</p>
    <p class="pipeline-stall-meta" data-stall-meta>Open to read task diagnoses&hellip;</p>
    <p class="pipeline-stall-sr" data-stall-live role="status" aria-live="polite"></p>
    <div data-stall-list></div>
    <button type="button" class="pipeline-btn compact" data-refresh-stall-list><i class="fas fa-rotate" aria-hidden="true"></i><span>Refresh diagnosis</span></button>
  </details>
  </section>

  <section class="pipeline-panel pipeline-team" id="pipelineHistory" aria-labelledby="pipelineTeamTitle">
    <div class="pipeline-panel-header pipeline-team-header">
      <div>
        <h2 id="pipelineTeamTitle"><i class="fas fa-people-group"></i> Coding Team history and performance</h2>
        <p>Attempts started in the selected period, across all tasks. These statistics do not describe the selected launch or the filtered board.</p>
      </div>
      <label class="pipeline-select">
        <span>Window</span>
        <select id="pipelineTeamWindow" aria-label="Coding Team performance window">
          <option value="7d">7 days</option>
          <option value="30d" selected>30 days</option>
          <option value="90d">90 days</option>
        </select>
      </label>
    </div>
    <div id="pipelineTeamState" class="pipeline-team-state" data-tone="loading" aria-live="polite">
      <i class="fas fa-spinner fa-spin" aria-hidden="true"></i>
      <span>Loading autonomous attempt evidence&hellip;</span>
    </div>
    <div class="pipeline-autonomy-archive"><h3>Archived Coding Team tasks</h3><p>Closed tasks and qualification records. Original outcomes and dependency barriers remain in force.</p><div id="codingAutonomyArchiveControls"></div><div id="codingAutonomyArchiveTasks" hidden></div></div>
    <div class="pipeline-team-metrics" aria-label="Coding Team scorecard">
      <article><span>Accepted</span><strong id="pipelineTeamAccepted">--</strong><small id="pipelineTeamAcceptedDetail">Human-accepted attempts; merge and deployment are separate</small></article>
      <article><span>First pass</span><strong id="pipelineTeamFirstPass">--</strong><small id="pipelineTeamFirstPassDetail">Share of accepted attempts</small></article>
      <article><span>Median cycle</span><strong id="pipelineTeamCycle">--</strong><small id="pipelineTeamCycleDetail">Task creation to human decision</small></article>
      <article><span>Corrections</span><strong id="pipelineTeamInterventions">--</strong><small id="pipelineTeamInterventionsDetail">Requeues and rejections</small></article>
      <article><span>Cost evidence</span><strong id="pipelineTeamCost">--</strong><small id="pipelineTeamCostDetail">Provider spend, measured energy, and electricity estimates stay distinct</small></article>
      <article><span>Evidence</span><strong id="pipelineTeamCoverage">--</strong><small id="pipelineTeamCoverageDetail">Structured attempt receipts</small></article>
    </div>
    <section id="pipelineTeamPhases" class="pipeline-phase-durations" aria-label="Attempt phase durations" aria-live="polite">
      <p class="pipeline-phase-state" data-tone="loading">Loading phase durations&hellip;</p>
    </section>
    <div class="pipeline-team-attempts">
      <div class="pipeline-team-attempts-head">
        <strong>Recent attempts</strong>
        <span id="pipelineTeamAttemptMeta">--</span>
      </div>
      <div class="pipeline-table-wrap">
        <table class="pipeline-table pipeline-team-table">
          <thead>
            <tr>
              <th scope="col">Task</th>
              <th scope="col">Worker</th>
              <th scope="col">Outcome</th>
              <th scope="col">Verification</th>
              <th scope="col">Change</th>
              <th scope="col">Phases</th>
              <th scope="col">Cost</th>
            </tr>
          </thead>
          <tbody id="pipelineTeamAttemptRows">
            <tr><td colspan="7" class="pipeline-empty">Loading attempt evidence&hellip;</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="pipeline-lower-grid pipeline-history-grid" aria-label="Completed work history">
    <section class="pipeline-panel">
      <div class="pipeline-panel-header">
        <div>
          <h2><i class="fas fa-flag-checkered"></i> Recently closed engineering tasks</h2>
          <p id="pipelineDoneMeta">--</p>
        </div>
      </div>
      <div id="pipelineDoneList" class="pipeline-done-list">
        <div class="pipeline-empty">Loading closed tasks&hellip;</div>
      </div>
    </section>

    <section class="pipeline-panel pipeline-delivery-history" aria-labelledby="pipelineDeliveryHistoryTitle">
      <div class="pipeline-panel-header"><div><h2 id="pipelineDeliveryHistoryTitle"><i class="fas fa-rocket"></i> Completed production deliveries</h2><p id="pipelineDeliveryHistoryMeta">Loading production evidence&hellip;</p></div></div>
      <div id="pipelineDeliveryHistoryList" class="pipeline-delivery-list" tabindex="0" role="region" aria-label="Completed delivery evidence"><div class="pipeline-empty">Delivery history loads independently.</div></div>
    </section>
  </section>
  <%- include('../partials/cockpit-guide', {
    cockpitGuide: {
      id: 'pipelineGuide',
      title: 'Read the queue, then act with the audited contract',
      summary: 'Pipeline follows engineering work by the Coding Team and human operators. Personal and family work stays in its own space; an explicitly selected attention queue remains available here for those lanes.',
      sections: [
        { title: 'Read the counts', body: 'The five status cards count engineering tasks only. Select one to focus the board, timeline, detailed queue and closed-task history on that stage; select it again to release the filter. Personal, family, household and secretary tasks do not contribute to these totals.' },
        { title: 'Follow a task group', body: 'Choose a group / epic beside the board to follow related tasks through completion. The board shows current statuses, including done. Timeline uses only recorded creation, update, attempt and decision events; unrecorded transitions and completion dates remain unknown. It does not infer deployment from done.' },
        { title: 'Measure the coding team', body: 'History and performance measures attempts started in its displayed 7, 30 or 90 day period across all tasks, independently of board filters and Run one task. Accepted attempts, task completion, merge and production proof are distinct. Coverage is always visible and missing metrics stay unknown rather than becoming zero.' },
        { title: 'Find the work', body: 'Search matches id, title, owner, epic, and source. Service and lane/source filters narrow the loaded rows; urgency sort surfaces blocked and overdue work first.' },
        { title: 'Create or edit', body: 'Use New task to open the guided French form, or Edit task in a dossier to clarify existing work. A title is required; expected result, classification and planning are optional. Classer et planifier explains services, groups, dates, dependencies and Planning links. Empty service means unspecified; empty group means ungrouped. The preview explains what saving will do. Creation adds a queued, unassigned task; taking it on follows queue conditions. In a coding dossier, expand Why can this task start, or why is it waiting? to inspect current conditions. Edits keep the current status, owner and history.' },
        { title: 'Get writing help', body: 'Aide à la rédaction avec l’IA turns an idea or requested change into a proposal. Review it, choose Utiliser ce brouillon, then save when ready. Manual editing works without a model.' },
        { title: 'Open the dossier', body: 'Select any row for the full task: specification, declared coding scope, per-attempt verification, measured cost and energy evidence, and the complete feedback audit trail. Inference content is intentionally excluded.' },
        { title: 'Start with the operator inbox', body: 'Follow and decide contains active deliveries; completed production deliveries remain in History. Evidence loads independently inside stable panels. Each item explains the change, evidence, risks, recommendation, and exact next action; GitHub remains available as a secondary expert link.' },
        { title: 'Record a human decision', body: 'A task in review can be accepted or returned for correction from its dossier — but only by an identity different from the worker. Current Coding Team attempts show their receipt; legacy dossiers without one are labeled explicitly and must be reconciled from their existing evidence.' },
        { title: 'Merge explicitly', body: 'Only a sealed exact PR with its accepted task, head SHA, required CI jobs, and GitHub mergeability revalidated can show the protected merge button. A click confirms that exact identity; there is no auto-merge.' },
        { title: 'Unstick what is stuck', body: 'Re-queue releases a task back to the queue (clearing its worker and heartbeat), and notes land in the same audit trail agents read.' },
        { title: 'Trust the heartbeat', body: 'In-progress work should heartbeat regularly. A silent hour marks it stale in Activity and raises it under Needs attention.' }
      ],
      note: { title: 'One bounded contract', body: 'This page reads and writes /api/pipeline/tasks and reads its aggregate /api/pipeline/performance projection — the same audited Mongo authority used by workers, human reviewers, and separately deployed boards. There is no privileged side channel.' },
      links: [
        { href: '/agent-ops', icon: 'fa-circle-nodes', label: 'Agent Ops', detail: 'Who does what, and is it running' },
        { href: '/planning', icon: 'fa-diagram-project', label: 'Planning', detail: 'Frozen reference of past workstreams' },
        { href: '/nerve-center', icon: 'fa-brain', label: 'Nerve Center', detail: 'Fleet and routing health' }
      ]
    }
  }) %>

