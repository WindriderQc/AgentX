      <label for="imagex-proposal-prompt">Brief proposé · modifiable</label><textarea id="imagex-proposal-prompt" rows="7" aria-describedby="imagex-apply-note"></textarea>
      <p id="imagex-proposal-counter" class="image-help" role="status"></p>
      <pre id="imagex-proposal-constraints" class="imagex-protected-constraints" aria-label="Contraintes utilisateur conservées" hidden></pre>
