    <div class="bg-grid"></div>

    <!-- Main Content -->
    <div class="cs-container oj-shell oj-calendar-shell">
        <%- include('../partials/automations-header', {resources: true}) %>

        <!-- Page Header -->
        <div class="cs-page-header">
            <div class="cs-header-row">
                <div>
                    <div class="cs-eyebrow">CALENDRIER / PLANIFICATION</div>
                    <h2>Les horaires et la capacité, ensemble</h2>
                    <p>Jobs récurrents, travaux lourds et capacité des hôtes. Les départs restent gérés par leurs planificateurs natifs.</p>
                </div>
                <div class="cs-header-controls">

                    <div id="headerStatus" class="cs-header-status"></div>
                    <div class="cs-date-nav">
                        <button id="prevDateBtn" class="cs-btn cs-btn-icon" title="Jour précédent" aria-label="Jour précédent"><i class="fas fa-chevron-left"></i></button>
                        <span class="cs-date-context" aria-live="polite">
                            <time id="dateLabel" class="cs-date-label">--</time>
                            <span id="dateZoneLabel" class="cs-date-zone" aria-label="Fuseau du navigateur"></span>
                        </span>
                        <button id="nextDateBtn" class="cs-btn cs-btn-icon" title="Jour suivant" aria-label="Jour suivant"><i class="fas fa-chevron-right"></i></button>
                        <button id="todayBtn" class="cs-btn cs-btn-sm">Aujourd’hui</button>
                    </div>
                    <div class="cs-view-toggles">
                        <button id="viewTask" class="cs-btn cs-btn-sm active" aria-pressed="true"><i class="fas fa-layer-group"></i> Tâches</button>
                        <button id="viewHost" class="cs-btn cs-btn-sm" aria-pressed="false"><i class="fas fa-server"></i> Hôtes</button>
                    </div>
                    <button id="refreshBtn" class="cs-btn" title="Actualiser les données" aria-label="Actualiser les données"><i class="fas fa-sync-alt"></i></button>
                </div>
            </div>
        </div>

        <!-- Services continus Strip -->
        <div id="servicesStrip" class="cs-services-strip" style="display:none">
            <div class="cs-services-header">
                <button id="servicesToggle" class="cs-btn cs-btn-sm" aria-expanded="true" aria-controls="servicesGrid">
                    <i class="fas fa-caret-down"></i> Services continus <span id="servicesCount" class="cs-services-count"></span>
                </button>
            </div>
            <div id="servicesGrid" class="cs-services-grid"></div>
        </div>

        <!-- Two-Column Layout: Main + Sidebar -->
        <div class="cs-two-col">

            <!-- Main Column -->
            <div class="cs-main">

                <div class="cs-catalogue-filters" aria-label="Filtrer le calendrier">
                    <label class="oj-search"><i class="fas fa-search" aria-hidden="true"></i><span class="oj-sr-only">Rechercher un job, un agent ou un hôte</span><input id="scheduleSearch" type="search" placeholder="Job, agent, hôte…" autocomplete="off"></label>
                    <label class="oj-filter"><span class="oj-sr-only">Propriétaire du job</span><select id="scheduleOwner"><option value="all">Tous les propriétaires</option><option value="operations">AgentX</option><option value="openclaw">OpenClaw</option><option value="core">Core</option><option value="infrastructure">Hôtes</option></select></label>
                </div>
                <!-- Timeline Filters -->
                <div id="timelineFilters" class="cs-timeline-filters" style="display:none">
                    <label class="cs-filter-label">
                        <input id="highFreqFilter" type="checkbox"> Inclure les jobs légers fréquents
                    </label>
                    <label class="cs-filter-label">
                        <input id="noGpuFilter" type="checkbox" checked> Inclure les tâches sans GPU
                    </label>
                </div>

                <!-- Heatmap / Timeline -->
                <div id="heatmapContainer" class="cs-heatmap-container">
                    <div class="cs-loading"><i class="fas fa-spinner fa-spin"></i> Chargement du calendrier…</div>
                </div>

<p class="cs-plan-note">Les marqueurs courts indiquent un départ prévu. Les durées sont estimées ; la consommation observée est dans « Utilisation mesurée ».</p>
                <!-- Measured use supplements the same calendar. -->
                <details class="cs-measurements" id="scheduleMeasurements"><summary><i class="fas fa-chart-line" aria-hidden="true"></i> Utilisation mesurée et comparaison avec le prévu</summary>
                <p id="liveEvidence" class="cs-live-evidence" aria-live="polite">Lecture des hôtes en cours…</p>
                <div id="liveBar" class="cs-live-bar" aria-describedby="liveEvidence">
                    <div class="cs-loading"><i class="fas fa-spinner fa-spin"></i> Chargement des hôtes…</div>
                </div>
                <div class="cs-actual-section">
                    <div class="cs-actual-header">
                        <div class="cs-actual-tabs">
                            <button id="btnHeatmap" class="cs-btn cs-btn-sm active" aria-pressed="true">
                                <i class="fas fa-th"></i> Utilisation mesurée
                            </button>
                            <button id="btnAvp" class="cs-btn cs-btn-sm" aria-pressed="false">
                                <i class="fas fa-chart-bar"></i> Mesuré / prévu
                            </button>
                        </div>
                        <div class="cs-actual-controls">
                            <label class="cs-filter-label">
                                Jours : <select id="heatmapDays" class="cs-select">
                                    <option value="1">1</option>
                                    <option value="3">3</option>
                                    <option value="7" selected>7</option>
                                    <option value="14">14</option>
                                    <option value="30">30</option>
                                </select>
                            </label>
                        </div>
                    </div>
                    <div id="utilLegend" class="cs-util-legend" style="display:none">
                        <span class="cs-util-legend-label">0%</span>
                        <div id="utilLegendBar" class="cs-util-legend-bar"></div>
                        <span class="cs-util-legend-label">100%</span>
                    </div>
                    <div id="actualContent" class="cs-actual-content"></div>
                </div>
                </details>
            </div>

            <!-- Sidebar -->
            <div class="cs-sidebar">

                <!-- Conflict Banner -->
                <div id="conflictBanner" class="cs-conflict-banner hidden">
                    <div class="cs-conflict-header"><i class="fas fa-exclamation-triangle"></i> VRAM overflows</div>
                    <div id="conflictText" class="cs-conflict-text"></div>
                </div>

                <div class="cs-panel">
                    <div class="cs-panel-header">
                        <h3><i class="fas fa-list-check"></i> Travaux lourds</h3>
                    </div>
                    <div id="heavyQueueList" class="cs-next-list" aria-live="polite">
                        <div class="cs-loading"><i class="fas fa-spinner fa-spin"></i> Chargement de la file…</div>
                    </div>
                    <p id="heavyQueueError" class="cs-queue-note" role="alert"></p>
                    <dialog id="heavyQueueReservation" class="cs-queue-dialog">
                        <form>
                            <h3 data-queue-title></h3>
                            <p data-queue-zone></p>
                            <label>Planned start <input type="datetime-local" name="start" required></label>
                            <label>Priority (1 first, 9 last) <input type="number" name="priority" min="1" max="9" required></label>
                            <label class="cs-queue-check" data-queue-auto hidden><input type="checkbox" name="autoStart"> Start it automatically at this time</label>
                            <p>Planning a slot acquires no runtime resources. Without an automatic start, nothing runs until someone starts it during the slot; Core checks the window, the host and the model again at launch.</p>
                            <p role="alert"></p>
                            <div class="cs-queue-actions">
                                <button type="submit" class="cs-queue-button">Enregistrer le créneau</button>
                                <button type="submit" class="cs-queue-button" value="cancel" formnovalidate>Fermer</button>
                            </div>
                        </form>
                    </dialog>
                </div>

                <!-- Prochains départs -->
                <div class="cs-panel">
                    <div class="cs-panel-header">
                        <h3><i class="fas fa-clock"></i> Prochains départs</h3>
                    </div>
                    <div id="nextList" class="cs-next-list">
                        <div class="cs-loading"><i class="fas fa-spinner fa-spin"></i> Loading...</div>
                    </div>
                </div>

                <div class="cs-panel">
                    <div class="cs-panel-header">
                        <h3><i class="fas fa-hand"></i> Réservations actives</h3>
                    </div>
                    <div id="claimsList" class="cs-claims-list">
                        <div class="cs-loading"><i class="fas fa-spinner fa-spin"></i> Loading...</div>
                    </div>
                </div>

                <!-- À surveiller Items -->
                <div class="cs-panel">
                    <div class="cs-panel-header">
                        <h3><i class="fas fa-bell"></i> À surveiller</h3>
                    </div>
                    <div id="attentionList" class="cs-attention-list"></div>
                </div>

                <!-- Légende -->
                <div class="cs-panel">
                    <div class="cs-panel-header">
                        <h3><i class="fas fa-palette"></i> Légende</h3>
                    </div>
                    <div id="legend" class="cs-legend"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tooltip (hidden by default) -->
    <div id="tooltip" class="cs-tooltip" role="tooltip" aria-hidden="true">
        <div id="tooltipType" class="cs-tooltip-type"></div>
        <div id="tooltipName" class="cs-tooltip-name"></div>
        <div id="tooltipRows" class="cs-tooltip-rows"></div>
    </div>

    <!-- Service Popover (hidden by default) -->
    <div id="servicePopover" class="cs-service-popover" role="dialog" aria-label="Services continus" aria-hidden="true"></div>
