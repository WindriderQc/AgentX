<% const { navItems, brandHref, brandTitle, isActive, isChildActive } = buildProductNavigation(locals); %>
<div id="nav-container" class="product-shell">
  <nav class="top-nav" aria-label="Navigation principale">
    <a href="<%= brandHref %>" class="nav-brand" title="<%= brandTitle %>" aria-label="<%= brandTitle %>">
      <img class="product-mark" src="/favicon.svg?v=agentx-mark-1" width="44" height="44" alt="" aria-hidden="true"><span>AgentX</span>
    </a>
    <div class="nav-right">
      <% navItems.forEach(function(item) { %>
        <div class="nav-item<%= item.secondary ? ' nav-system' : '' %>">
          <button type="button" class="nav-link<%= isChildActive(item.children) ? ' active' : '' %>" id="nav-trigger-<%= item.id %>" aria-controls="nav-menu-<%= item.id %>" aria-expanded="false">
            <i class="fas <%= item.icon %>" aria-hidden="true"></i><span><%= item.label %></span><i class="fas fa-angle-down nav-chevron" aria-hidden="true"></i>
          </button>
          <div class="nav-dropdown" id="nav-menu-<%= item.id %>" aria-labelledby="nav-trigger-<%= item.id %>">
            <% item.children.forEach(function(child) { %>
              <% if (child.section) { %>
                <div class="nav-dropdown-section"><%= child.section %></div>
              <% } else if (child.action) { %>
                <button type="button" class="dropdown-item" data-nav-action="<%= child.action %>"><i class="fas <%= child.icon %>" aria-hidden="true"></i><%= child.label %></button>
              <% } else { %>
                <a href="<%= child.href %>" class="dropdown-item<%= isActive(child.id) ? ' active' : '' %>"
                   <% if (isActive(child.id)) { %>aria-current="page"<% } %>
                   <% if (child.external) { %>target="_blank" rel="noopener"<% } %>
                   <% if (child.owner) { %>data-nav-owner="<%= child.owner %>"<% } %>
                   <% if (child.description) { %>title="<%= child.description %>"<% } %>
                   >
                  <i class="fas <%= child.icon %>" aria-hidden="true"></i><%= child.label %>
                  <% if (child.owner) { %><span class="nav-owner-tag"><%= child.owner %></span><% } %>
                  <% if (child.external) { %><i class="fas fa-arrow-up-right-from-square nav-external" aria-label="Nouvel onglet"></i><% } %>
                </a>
              <% } %>
            <% }); %>
          </div>
        </div>
      <% }); %>
    </div>
    <% if (locals.householdControls) { %>
      <details class="nav-tools" id="householdTools">
        <summary aria-label="Accès et réglages"><i class="fas fa-ellipsis" aria-hidden="true"></i></summary>
        <div class="nav-tools-panel">
          <% if (locals.householdControls) { %><button type="button" id="readingVoiceSettings">Voix des lectures</button><span class="runtime-pill" id="runtimePill" role="status">Connexion…</span><% } %>
        </div>
      </details>
    <% } %>
  </nav>
</div>
<%- include('shortcuts-modal') %>
<script src="/js/product-navigation.js" defer></script>
