{
  "name": "agentx-core",
  "version": "0.2.0",
  "description": "Agent X Core — local inference, routing, telemetry, and product APIs",
  "main": "server.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "predev": "node esbuild.config.mjs",
    "prestart": "node esbuild.config.mjs",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node scripts/run-jest.js",
    "test:surfaces": "node scripts/run-surface-tests.js && npm run test:integrations --prefix .. && npm run test:shared --prefix ..",
    "test:images:browser": "node tests/browser/imageWorkshopJourney.cjs",
    "test:unit": "node scripts/run-jest.js tests/unit --coverage",
    "test:integration": "node scripts/run-jest.js tests/integration",
    "db:indexes": "node scripts/create-indexes.js",
    "seed:personas": "node scripts/seed-persona.js",
    "test:nodb": "node scripts/run-jest.js --config jest.nodb.config.js",
    "test:prepare": "node ../shared/testing/prepareMongo.js"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fortawesome/fontawesome-free": "6.4.0",
    "chart.js": "4.4.4",
    "chartjs-4-5-1": "npm:chart.js@4.5.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cron-parser": "^5.5.0",
    "dompurify": "3.4.16",
    "dotenv": "^17.2.3",
    "ejs": "^5.0.1",
    "esbuild": "^0.28.0",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "helmet": "^8.1.0",
    "jpeg-js": "0.4.4",
    "js-yaml": "5.4.2",
    "marked": "18.0.11",
    "mongoose": "^8.9.5",
    "node-fetch": "^2.7.0",
    "pdf-parse": "^2.4.5",
    "pngjs": "7.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "@types/jest": "^30.0.0",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^10.2.1",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4"
  },
  "overrides": {
    "mongodb": "^6.5.0",
    "bson": "^6.5.0",
    "glob": "^13.0.6",
    "test-exclude": "^8.0.0",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.3.1"
    },
    "qs": "^6.16.0"
  },
  "engines": {
    "node": ">=24"
  }
}
