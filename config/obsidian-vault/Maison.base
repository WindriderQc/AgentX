filters:
  and:
    - file.inFolder("Docs/Maison")
properties:
  note.garantie_fin:
    displayName: Garantie jusqu'au
  note.achat:
    displayName: Acheté le
  note.piece:
    displayName: Pièce
  note.espece:
    displayName: Espèce
  note.arrosage_jours:
    displayName: Arrosage (jours)
  note.arrosage_hiver_jours:
    displayName: Arrosage l'hiver (jours)
  note.toxicite_enfants:
    displayName: Toxicité enfants
views:
  - type: table
    name: Garanties
    filters:
      and:
        - type == "appareil"
    order:
      - file.name
      - note.piece
      - note.marque
      - note.achat
      - note.garantie_fin
      - note.manuel
  - type: table
    name: Routines
    filters:
      and:
        - type == "routine"
    order:
      - file.name
      - note.quand
      - note.qui
  - type: table
    name: Recettes et procédures
    filters:
      or:
        - type == "recette"
        - type == "procedure"
    groupBy:
      property: note.type
      direction: ASC
    order:
      - file.name
      - note.portions
      - note.temps
      - note.quand
  - type: table
    name: Plantes
    filters:
      and:
        - type == "plante"
    order:
      - file.name
      - note.espece
      - note.piece
      - note.lumiere
      - note.arrosage_jours
      - note.arrosage_hiver_jours
      - note.toxicite_enfants
      - note.toxicite_chats
      - note.toxicite_chiens
