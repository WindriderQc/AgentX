# Private HTTPS only. Replace this example LAN bind address and local DNS name.
# Keep every backend on loopback and databases on the internal Compose network.
# These complete application entries proxy pages, assets and APIs directly.
# Do not replace unrelated native-integration gates (for example DSH Studio).
{
	# Avoid adding an automatic wildcard HTTP redirect listener.
	auto_https disable_redirects
}

(agentx_private_lan) {
	bind 192.168.1.10
	tls internal
	@outside not remote_ip private_ranges
	respond @outside "Private LAN only" 403
}

https://household.example.invalid {
	import agentx_private_lan
	reverse_proxy 127.0.0.1:3180
}
https://household.example.invalid:3081 {
	import agentx_private_lan
	reverse_proxy 127.0.0.1:3181
}
https://household.example.invalid:3082 {
	import agentx_private_lan
	reverse_proxy 127.0.0.1:3182
}
# Optional Data entry; omit if Data is used only through Core's read-only Toolbox.
https://household.example.invalid:3083 {
	import agentx_private_lan
	reverse_proxy 127.0.0.1:3183
}
