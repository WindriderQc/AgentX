# Secret-free Compose inputs. Shell variables may override these values.
AGENTX_OLLAMA_HOST=http://host.docker.internal:11434
# Optional exact HTTP(S) origins for first-time Benchmark setup on a
# nonstandard Ollama port. Comma-separated; never include paths or credentials.
AGENTX_OLLAMA_ALLOWED_TARGETS=
OLLAMA_HOST_NAME=Local Ollama
# One embedding model per Qdrant collection: a model with another dimension
# needs a new QDRANT_COLLECTION (docs/OPERATIONS.md, "Switching the embedding
# model"). Multilingual instances use qllama/bge-m3:f16 / 1024.
EMBEDDING_MODEL=nomic-embed-text:v1.5
EMBEDDING_DIMENSION=768
QDRANT_COLLECTION=agentx_product_embeddings
CORE_PORT=3180
BENCHMARK_PORT=3181
RAG_PORT=3182
# Opt in with COMPOSE_PROFILES=data and AGENTX_PROFILE=full.
DATA_PORT=3183
DATA_BACKGROUND_JOBS_ENABLED=false
# Optional out-of-Git JSON with this share's folder-name aliases for the Data
# file classifier (docs/OPERATIONS.md). Path as seen inside the Data container.
DATA_PATH_ROLE_ALIASES_FILE=
# Optional full-profile integrations. Native runtime configuration stays external.
AGENTX_RUNTIME_BRIDGES_ENABLED=false
AGENTX_PRINTER_VISION_ENABLED=false
# Optional same-origin link from the full Product portal back to the composing
# host. Leave blank for standalone/shareable Product. Example: /
AGENTX_HOST_HOME_URL=
AGENTX_HOST_HOME_LABEL=Back to host
# Optional docked avatar for Super Dad and Famille: the GraphysX <llmx-face>
# module, relayed from Household's own origin. Blank shows the 2D presence orb.
# Example: https://graphysx.example/embed/llmx-face.js
HOUSEHOLD_AVATAR_MODULE_URL=
# Optional native provider/model for personal Nestor voice on the main agent.
# Blank keeps native model policy; explicit Open, text and family are unaffected.
HOUSEHOLD_VOICE_MODEL=
# Optional engine of new Family conversations (Famille, Kids Room, Lecture,
# native Family voice): agentx (Core inference) or openclaw. Blank follows
# HOUSEHOLD_CONVERSATION_BACKEND. Existing conversations keep their engine.
HOUSEHOLD_FAMILY_CONVERSATION_BACKEND=
# Router task of a spoken turn on Core inference; typed turns keep the pack task.
HOUSEHOLD_VOICE_TASK=voice_persona_chat
# Optional instance voice per persona: JSON {"<persona id>" or "*": "provider|voice"},
# e.g. a locally configured VoxCPM2 voice for every persona: {"*":"voxcpm|example"}.
# A browser's own voice selection still wins. Blank keeps the catalog voices.
HOUSEHOLD_PERSONA_VOICES=
# Optional team members the owner may address directly in Super Dad: JSON
# {"<OpenClaw agent id>": ["name", ...]}, e.g. {"secretary":["secretary"]}.
# "Secretary, ..." or "ask the secretary ..." then goes to that agent and is
# spoken with its own personality's voice. Blank: every turn stays with the
# conversation's agent.
HOUSEHOLD_TEAM_MEMBERS=
# Optional Council runtime participants: true seats OpenClaw agents (through the
# gateway above) or the Codex bridge. Convening them needs the chair token,
# a private instance secret.
ROUNDTABLE_RUNTIME_PARTICIPANTS_ENABLED=
ROUNDTABLE_CHAIR_TOKEN=
# Optional browser speech recognition when local transcription (VoiX) is
# unavailable: false (default), personal (Super Dad only) or true (both spaces).
# Each browser must still consent per space. In Chrome and Edge the microphone
# audio is sent to the browser vendor's cloud service and leaves the network.
HOUSEHOLD_BROWSER_STT_FALLBACK=false
# Optional pictures beside Nestor. SEARXNG_URL enables internet image search.
# Household photos and media are found through the Data file index and served
# from read-only mounts: *_DIR is the host folder, and the JSON maps each source
# to the canonical root Data indexes for it. Blank keeps those sources off.
# Example: HOUSEHOLD_PHOTOS_DIR=/srv/example/photos and
# HOUSEHOLD_IMAGE_ROOTS_JSON={"photos":"/mnt/example/photos"}
# Pictures the OpenClaw agent generates reach the Images zone through the
# Nestor plugin's media route on the configured gateway; nothing to set here.
SEARXNG_URL=
HOUSEHOLD_PHOTOS_DIR=
HOUSEHOLD_MEDIA_DIR=
HOUSEHOLD_IMAGE_ROOTS_JSON=
HOUSEHOLD_IMAGE_FAMILY_SOURCES=web,photos,media,generated
# Nestor's background reviewer ("brain") after each Super Dad / Famille turn.
# Blank model and host use the router's master_brain lane. HOUSEHOLD_BRAIN_MODEL
# names an Ollama model; HOUSEHOLD_BRAIN_HOST_URL pins it to one Ollama host,
# e.g. http://gpu-host.example:11434. A new turn supersedes a running review; on a
# pinned host its request finishes and its result is discarded (never cancelled).
# HOUSEHOLD_BRAIN_EXCLUSIVE=true asks for exclusive admission on that host (waits
# for an idle host, blocks other callers, unloads co-resident models).
HOUSEHOLD_BRAIN_ENABLED=true
HOUSEHOLD_BRAIN_FAMILY=true
HOUSEHOLD_BRAIN_MODEL=
HOUSEHOLD_BRAIN_HOST_URL=
HOUSEHOLD_BRAIN_EXCLUSIVE=false
VOIX_SPOKEN_CONTROLS_ENABLED=false
# Optional backup VoiX for transcription, synthesis, the voice catalog and the
# player script while VOIX_BASE_URL fails its /health probe, e.g.
# http://voice-backup.example:8765. Sessions, media vault and config stay on
# the primary. The conversation page says when the slower backup answers.
VOIX_FALLBACK_URL=
