{
  "name": "SBQC - N3.3 Performance Monitor (Auditor)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hours": 6
            }
          ]
        }
      },
      "id": "ScheduleTrigger",
      "name": "Schedule (6 hours)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        -800,
        0
      ]
    },
    {
      "parameters": {
        "path": "sbqc-n3-3-performance-monitor",
        "options": {}
      },
      "id": "WebhookTrigger",
      "name": "Webhook (Manual)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -800,
        200
      ],
      "webhookId": "sbqc-n3-3-performance-monitor"
    },
    {
      "parameters": {},
      "id": "MergeTriggers",
      "name": "Merge Triggers",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        -550,
        100
      ]
    },
    {
      "parameters": {
        "command": "cd /home/yb/codes/AgentX && ./scripts/import-artillery-results.sh basic-load",
        "options": {}
      },
      "id": "RunLoadTest",
      "name": "Run Artillery Load Test",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        -300,
        100
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "url": "http://localhost:3080/api/performance/baseline-compare",
        "options": {}
      },
      "id": "CheckBaseline",
      "name": "Check Baseline Comparison",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        100
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.data.regression_detected }}",
              "value2": true
            }
          ]
        }
      },
      "id": "CheckRegression",
      "name": "Check if Regression Detected",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        300,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3080/api/alerts",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"alert_type\": \"performance_regression\",\n  \"severity\": \"high\",\n  \"component_type\": \"agentx\",\n  \"component_id\": \"performance-monitor\",\n  \"message\": \"Performance regression detected in load test\",\n  \"metadata\": {\n    \"regressions\": {{ $json.data.regressions }},\n    \"baseline_name\": \"{{ $json.data.baseline.name }}\",\n    \"current_metrics\": {{ $json.data.current }},\n    \"workflow_id\": \"N3.3-performance-monitor\"\n  },\n  \"channels\": [\"slack\", \"dataapi_log\"]\n}",
        "options": {}
      },
      "id": "CreateAlert",
      "name": "Create Alert (Regression)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "PIrrA2wpOppzVodi",
          "name": "Header Auth account"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://192.168.2.33:3003/integrations/events/n8n",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"workflow_id\": \"SBQC-N3.3-performance-monitor\",\n  \"event_type\": \"performance_regression\",\n  \"severity\": \"high\",\n  \"data\": {\n    \"regressions\": {{ $json.data.regressions }},\n    \"baseline\": \"{{ $json.data.baseline.name }}\",\n    \"timestamp\": \"{{ new Date().toISOString() }}\"\n  }\n}",
        "options": {}
      },
      "id": "LogToDataAPI",
      "name": "Log Regression to DataAPI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "PIrrA2wpOppzVodi",
          "name": "Header Auth account"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://192.168.2.33:3003/integrations/events/n8n",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"workflow_id\": \"SBQC-N3.3-performance-monitor\",\n  \"event_type\": \"performance_check_passed\",\n  \"severity\": \"info\",\n  \"data\": {\n    \"baseline\": \"{{ $json.data.baseline.name }}\",\n    \"current_metrics\": {{ $json.data.current }},\n    \"timestamp\": \"{{ new Date().toISOString() }}\"\n  }\n}",
        "options": {}
      },
      "id": "LogPassToDataAPI",
      "name": "Log Pass to DataAPI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        400
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "PIrrA2wpOppzVodi",
          "name": "Header Auth account"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3080/api/metrics/performance",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"component_type\": \"agentx\",\n  \"component_id\": \"performance-monitor\",\n  \"metric_type\": \"load_test_completed\",\n  \"value\": 1,\n  \"metadata\": {\n    \"regression_detected\": {{ $json.data.regression_detected }},\n    \"baseline\": \"{{ $json.data.baseline.name }}\",\n    \"p95_latency\": {{ $json.data.current.p95_latency }},\n    \"error_rate\": {{ $json.data.current.error_rate }}\n  }\n}",
        "options": {}
      },
      "id": "RecordMetric",
      "name": "Record Metric",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "PIrrA2wpOppzVodi",
          "name": "Header Auth account"
        }
      },
      "continueOnFail": true
    }
  ],
  "connections": {
    "Schedule (6 hours)": {
      "main": [
        [
          {
            "node": "Merge Triggers",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook (Manual)": {
      "main": [
        [
          {
            "node": "Merge Triggers",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Merge Triggers": {
      "main": [
        [
          {
            "node": "Run Artillery Load Test",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Artillery Load Test": {
      "main": [
        [
          {
            "node": "Check Baseline Comparison",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Baseline Comparison": {
      "main": [
        [
          {
            "node": "Check if Regression Detected",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check if Regression Detected": {
      "main": [
        [
          {
            "node": "Create Alert (Regression)",
            "type": "main",
            "index": 0
          },
          {
            "node": "Log Regression to DataAPI",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Pass to DataAPI",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Alert (Regression)": {
      "main": [
        [
          {
            "node": "Record Metric",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Regression to DataAPI": {
      "main": [
        [
          {
            "node": "Record Metric",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Pass to DataAPI": {
      "main": [
        [
          {
            "node": "Record Metric",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1",
  "meta": {
    "instanceId": "c5e6a1f0e1e97e6d5e7a8c2f9b3d4e5f"
  },
  "id": "N3.3-performance-monitor",
  "tags": [
    {
      "id": "auditor",
      "name": "Auditor"
    },
    {
      "id": "performance",
      "name": "Performance"
    }
  ]
}
