# Copy to an owner-only path such as /etc/agentx/benchmark-harness-broker.env.
# Never commit populated credentials or private endpoints.
AGENTX_BENCHMARK_SPEND_SIGNING_KEY=
BENCHMARK_HARNESS_TARGETS_PATH=/etc/agentx/benchmark-harness-targets.json
BENCHMARK_HARNESS_AUDIT_PATH=/var/log/agentx/benchmark-harness-audit.jsonl
BENCHMARK_HARNESS_SPEND_LEDGER_PATH=/var/lib/agentx/benchmark-harness/spend-ledger.jsonl
BENCHMARK_HARNESS_BIND=127.0.0.1
BENCHMARK_HARNESS_PORT=3091

# The OpenClaw version label must match the immutable catalog. Runtime and
# profile SHA-256 pins themselves live in the owner-only target catalog and are
# re-hashed by the broker before discovery and every cell.
OPENCLAW_RUNTIME_VERSION=

# Executor-specific paths/endpoints and credentials stay in the private instance.
OPENCLAW_CONFIG_PATH=
OPENROUTER_API_KEY=
HERMES_BENCHMARK_BASE_URL=
HERMES_BENCHMARK_TOKEN=

# Disabled-by-default local isolated targets use one fixed pair per host. The
# owner-only catalog must name only the corresponding environment variables.
OLLAMA_HOST_A_BENCHMARK_BASE_URL=
OLLAMA_HOST_A_BENCHMARK_VERSION=
OLLAMA_HOST_B_BENCHMARK_BASE_URL=
OLLAMA_HOST_B_BENCHMARK_VERSION=
