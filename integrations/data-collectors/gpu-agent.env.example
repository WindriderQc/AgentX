# Copy to an owner-only path outside Git, for example ~/.config/agentx/gpu-agent.env.
# Never commit a populated copy: host names, SSH users and addresses are instance data.

# Data's loopback port on the Core host (Compose publishes Data on 127.0.0.1:${DATA_PORT}).
DATA_URL=http://127.0.0.1:3183

# Stable collector identifier, shown in /api/v1/hardware/collectors.
GPU_AGENT_ID=gpu-agent

# Host list: a JSON file (preferred) or inline GPU_AGENT_HOSTS_JSON. Remote hosts
# are reached with key-based SSH in batch mode; nothing is installed on them.
# The example unit sets GPU_AGENT_HOSTS_FILE=%h/.config/agentx/gpu-hosts.json
# (systemd expands %h in the unit, not in this file). Override it here with an
# absolute path if the list lives elsewhere.
# GPU_AGENT_HOSTS_JSON=[{"id":"gpu-a","name":"GPU A","ssh":"agentx@gpu-a.example","ollamaUrl":"http://gpu-a.example:11434"},{"id":"core","local":true}]

# Sampling interval (5 s .. 10 min) and per-host command timeout (2 .. 60 s).
GPU_AGENT_INTERVAL_MS=30000
GPU_AGENT_HOST_TIMEOUT_MS=10000

# Ollama server settings (KV cache type, flash attention, parallel requests...)
# of hosts that set "ollamaService": read-only, every 1 min .. 24 h (default 10 min).
GPU_AGENT_OLLAMA_ENV_INTERVAL_MS=600000
