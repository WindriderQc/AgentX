# Speech service settings. Copy to `.env` in this directory on the voice host,
# or provide the same variables through the instance's own launcher. Values
# that name people or machines belong to the instance, never to this repository.

# Default language of a request that names none.
VOIX_LANGUAGE=fr
# Load recognition and synthesis at startup so the first request is not cold.
VOIX_STARTUP_WARMUP=true
# Where saved speech choices (engine and voices) live. Default:
# %LOCALAPPDATA%\VoiX\voice-preferences.json, or ~/.local/share/VoiX/ elsewhere.
VOIX_PREFERENCES_PATH=

# --- Recognition (faster-whisper) ---
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8_float16
# Probability of speech required to start an uploaded speech interval (0..1).
# This is not microphone volume; raise/lower only with noise and real-voice evidence.
WHISPER_VAD_THRESHOLD=0.85
# Names Whisper should prefer. Add the instance's own names here.
WHISPER_HOTWORDS=Nestor, AgentX, OpenClaw, VoiX
WHISPER_INITIAL_PROMPT=Conversation en français québécois avec Nestor. Noms propres : Nestor, AgentX, OpenClaw et VoiX.
# Optional JSON file of instance transcript corrections, outside the repository:
# [{"pattern": "\\bregular expression\\b", "replacement": "Canonical Name"}]
VOIX_STT_CORRECTIONS_PATH=

# --- Synthesis ---
#   kokoro       = default engine
#   windows_sapi = low-latency voices installed on a Windows host
#   voxcpm       = optional cloned voice served by a separate worker
TTS_PROVIDER=kokoro
TTS_OUTPUT_RATE=24000
# One voice id, or a weighted blend such as am_michael:0.50+ff_siwis:0.50.
KOKORO_VOICE=af_sarah
KOKORO_LANGUAGE=fr-fr
KOKORO_PAD_MS=60
# CUDAExecutionProvider uses the GPU; CPUExecutionProvider is the default.
ONNX_PROVIDER=CPUExecutionProvider
# Blank downloads the model files into cache/models on first use.
KOKORO_MODEL_PATH=
KOKORO_VOICES_PATH=
WINDOWS_SAPI_VOICE=
WINDOWS_SAPI_RATE=0

# --- Optional cloned-voice worker: VoxCPM2 or Pocket TTS (docs/voxcpm-streaming.md) ---
VOXCPM_BASE_URL=
VOXCPM_VOICE=nestor-a
# Name shown in voice pickers for the configured reference.
VOXCPM_VOICE_NAME=
VOXCPM_TIMEOUT_SECONDS=60
