index 0000000..d61079d
--- /dev/null
+++ b/src/agentx_harness.rs
@@ -0,0 +1,544 @@
+//! AgentX one-turn harness adapters: DeepSeek Harness (`dsh headless`) and pi
+//! (`pi -p`).
+//!
+//! Both answer one prompt and exit, so they cannot loop through a Stop hook as
+//! Codex and Claude do. The agent command is `agentx_harness_loop.py`, which
+//! runs the harness turn after turn in one session with the auto-continue
+//! prompt and writes Codex-shaped rollouts (`~/.agentx-loop/sessions`). The
+//! replay reads them with the Codex parser; the AgentX island runner reads the
+//! same files for activity and stall recovery.
+//!
+//! The harness talks to one OpenAI-compatible base URL given by the caller in
+//! `AGENTX_LLM_BASE_URL`, with its capability in `AGENTX_LLM_TOKEN`. With
+//! network isolation the base URL must be a loopback relay of
+//! `CLAWBLOX_NET_ALLOW`. The generated HOME holds only the provider config,
+//! the loop state and what the harness writes itself; owner state is never
+//! copied in.
+
+use std::path::{Path, PathBuf};
+
+use super::{
+    agent_home_dir, create_parent_dir, env_value, node_root_for_path, require_nonempty,
+    require_program, resolve_node_root, write_file, write_json_file, write_sandbox_hosts_file,
+    Agent, AgentContext, AgentError, AgentResult, CommandSpec, SandboxRequirements,
+};
+use crate::agent_sandbox::SandboxLayout;
+use crate::replay_agent_log::{CodexTranscriptParser, TranscriptLineParser};
+
+pub const LOOP_PY: &str = include_str!("agentx_harness_loop.py");
+const LOOP_FILE: &str = "agentx_harness_loop.py";
+const STATE_DIR: &str = ".agentx-loop";
+const GUEST_HARNESS_ROOT: &str = "/sandbox-harness";
+pub const BASE_URL_ENV: &str = "AGENTX_LLM_BASE_URL";
+pub const TOKEN_ENV: &str = "AGENTX_LLM_TOKEN";
+pub const CONTEXT_ENV: &str = "AGENTX_LLM_CONTEXT_WINDOW";
+pub const MAX_OUTPUT_ENV: &str = "AGENTX_LLM_MAX_OUTPUT_TOKENS";
+const PROVIDER: &str = "agentx-core";
+const DSH_PATCH: &str = ".dsh/agentx-island.patch.json";
+
+/// DSH plugins that would add hidden concurrency, background model calls,
+/// telemetry or a second provider. Same list as AgentX's coding-team guard,
+/// plus the web and DeepSeek-account plugins (there is no network anyway).
+const DSH_DISABLED: &[&str] = &[
+    "tool-subagent-control",
+    "tool-subagent-list-agents",
+    "tool-subagent",
+    "tool-subagent-fork",
+    "tool-subagent-report",
+    "tool-workflow",
+    "tool-plugin-manager",
+    "session-title-llm",
+    "session-telemetry-otel",
+    "web-search-deepseek",
+    "web-deepseek-api",
+    "tool-web",
+    "llm-deepseek",
+    "llm-deepseek-account",
+];
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum LoopKind {
+    Dsh,
+    Pi,
+}
+
+impl LoopKind {
+    fn name(self) -> &'static str {
+        match self {
+            Self::Dsh => "dsh",
+            Self::Pi => "pi",
+        }
+    }
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct LoopAgent {
+    pub kind: LoopKind,
+    pub binary: PathBuf,
+}
+
+impl LoopAgent {
+    pub fn new(kind: LoopKind, binary: Option<PathBuf>) -> Self {
+        Self {
+            kind,
+            binary: binary.unwrap_or_else(|| PathBuf::from(kind.name())),
+        }
+    }
+}
+
+/// `<root>/node_modules/...` → (root, "/node_modules/..."), for the outermost
+/// node_modules so the whole installed tree is mounted read-only.
+pub fn harness_root_for_bin(path: &Path) -> Option<(PathBuf, PathBuf)> {
+    let path = std::fs::canonicalize(path).ok()?;
+    let text = path.to_string_lossy().to_string();
+    let index = text.find("/node_modules/")?;
+    Some((PathBuf::from(&text[..index]), PathBuf::from(&text[index..])))
+}
+
+fn state_dir(ctx: &AgentContext) -> PathBuf {
+    agent_home_dir(ctx).join(STATE_DIR)
+}
+
+fn guest_state_dir(ctx: &AgentContext) -> PathBuf {
+    ctx.guest_home().join(STATE_DIR)
+}
+
+fn guest_prompt_file(ctx: &AgentContext) -> PathBuf {
+    match &ctx.sandbox {
+        Some(layout) => layout.guest_runtime.join("system_prompt.md"),
+        None => ctx.paths.prompt_file.clone(),
+    }
+}
+
+fn guest_loop_file(ctx: &AgentContext) -> PathBuf {
+    ctx.guest_path(&ctx.paths.runtime_dir.join(LOOP_FILE))
+}
+
+fn positive_env(ctx: &AgentContext, key: &str, default: Option<u64>) -> AgentResult<Option<u64>> {
+    match env_value(ctx, key) {
+        None => Ok(default),
+        Some(value) => match value.trim().parse::<u64>() {
+            Ok(number) if number > 0 => Ok(Some(number)),
+            _ => Err(AgentError::InvalidConfig(format!("{key} must be a positive integer"))),
+        },
+    }
+}
+
+/// The provider base URL; with network isolation it must be a loopback relay.
+pub fn provider_base_url(ctx: &AgentContext) -> AgentResult<String> {
+    let url = env_value(ctx, BASE_URL_ENV)
+        .ok_or_else(|| AgentError::InvalidConfig(format!("{BASE_URL_ENV} is required")))?;
+    let rest = url
+        .strip_prefix("http://127.0.0.1:")
+        .ok_or_else(|| AgentError::InvalidConfig(format!("{BASE_URL_ENV} must be http://127.0.0.1:<port>/<path>")))?;
+    let (port, path) = rest.split_once('/').unwrap_or((rest, ""));
+    let port: u16 = port
+        .parse()
+        .map_err(|_| AgentError::InvalidConfig(format!("{BASE_URL_ENV} has an invalid port")))?;
+    if path.is_empty() || path.contains(['?', '#', '@']) || path.split('/').any(|part| part == "..") {
+        return Err(AgentError::InvalidConfig(format!("{BASE_URL_ENV} needs an explicit API path")));
+    }
+    if crate::net_isolation::enabled(ctx)
+        && !crate::net_isolation::routes(ctx)
+            .iter()
+            .any(|route| route.hostname.is_some() && route.guest_port == port)
+    {
+        return Err(AgentError::InvalidConfig(format!(
+            "{BASE_URL_ENV} port {port} is not a relay of {}",
+            crate::net_isolation::ALLOW_ENV
+        )));
+    }
+    Ok(url.trim_end_matches('/').to_string())
+}
+
+fn model_entry(ctx: &AgentContext) -> AgentResult<serde_json::Value> {
+    let mut model = serde_json::json!({ "id": ctx.settings.model, "name": ctx.settings.model });
+    if let Some(window) = positive_env(ctx, CONTEXT_ENV, None)? {
+        model["contextWindow"] = window.into();
+    }
+    model["maxTokens"] = positive_env(ctx, MAX_OUTPUT_ENV, Some(32768))?.unwrap_or(32768).into();
+    Ok(model)
+}
+
+/// Same compatibility notes as AgentX's coding-team DSH provider.
+fn compat() -> serde_json::Value {
+    serde_json::json!({ "supportsDeveloperRole": false, "maxTokensField": "max_tokens", "thinkingFormat": "deepseek" })
+}
+
+pub fn pi_models_json(ctx: &AgentContext) -> AgentResult<serde_json::Value> {
+    Ok(serde_json::json!({ "providers": { PROVIDER: {
+        "baseUrl": provider_base_url(ctx)?,
+        "api": "openai-completions",
+        "apiKey": format!("${TOKEN_ENV}"),
+        "compat": compat(),
+        "models": [model_entry(ctx)?],
+    }}}))
+}
+
+pub fn dsh_patch(ctx: &AgentContext) -> AgentResult<serde_json::Value> {
+    let mut model = model_entry(ctx)?;
+    if let Some(object) = model.as_object_mut() {
+        object.remove("name");
+    }
+    let suffix = std::fs::read_to_string(&ctx.paths.prompt_file).unwrap_or_default();
+    let mut patch = vec![
+        serde_json::json!({ "id": "llm-pi-ai", "config": { "providers": { PROVIDER: {
+            "displayName": "AgentX Core",
+            "apiKeyEnv": TOKEN_ENV,
+            "api": "openai-completions",
+            "baseURL": provider_base_url(ctx)?,
+            "compat": compat(),
+            "models": [model],
+        }}}}),
+        serde_json::json!({ "id": "agent-default-model",
+                            "config": { "provider": PROVIDER, "model": ctx.settings.model } }),
+        // Keep DSH's own persona and add the island prompt after it, as Codex
+        // does with developer_instructions.
+        serde_json::json!({ "id": "system-prompt", "config": {
+            "personaPrefix": "You are a coding agent powered by the {{model}} model.",
+            "personaSuffix": suffix,
+        }}),
+        serde_json::json!({ "id": "session-persistence-jsonl", "config": {
+            "root": ctx.guest_home().join(".dsh/sessions").display().to_string(),
+            "compression": "none",
+        }}),
+    ];
+    patch.extend(DSH_DISABLED.iter().map(|id| serde_json::json!({ "id": id, "disabled": true })));
+    Ok(serde_json::Value::Array(patch))
+}
+
+impl Agent for LoopAgent {
+    fn name(&self) -> &'static str {
+        self.kind.name()
+    }
+
+    fn default_model(&self) -> &'static str {
+        "agentx-primary"
+    }
+
+    fn binary(&self) -> &Path {
+        &self.binary
+    }
+
+    fn configure_sandbox_layout(&self, layout: SandboxLayout, host_binary: &Path) -> AgentResult<SandboxLayout> {
+        let mut layout = layout;
+        if let Some((root, rel)) = harness_root_for_bin(host_binary) {
+            layout = layout.with_binary_root(root, PathBuf::from(GUEST_HARNESS_ROOT), rel);
+        }
+        if let Some(root) = node_root_for_path(host_binary).or_else(resolve_node_root) {
+            layout = layout.with_node_root(root);
+        }
+        Ok(layout)
+    }
+
+    fn check_setup(&self, ctx: &AgentContext) -> AgentResult<()> {
+        ctx.validate()?;
+        require_program(&self.binary, &format!("{} CLI", self.kind.name()))?;
+        provider_base_url(ctx)?;
+        model_entry(ctx)?;
+        Ok(())
+    }
+
+    fn start(&self, ctx: &AgentContext) -> AgentResult<CommandSpec> {
+        ctx.validate()?;
+        Ok(self.loop_command(ctx, &ctx.settings.initial_prompt, false))
+    }
+
+    fn continue_session(&self, ctx: &AgentContext, prompt: &str) -> AgentResult<CommandSpec> {
+        ctx.validate()?;
+        require_nonempty("prompt", prompt)?;
+        let session = std::fs::read_to_string(state_dir(ctx).join("session_id")).unwrap_or_default();
+        require_nonempty("session_id", session.trim())?;
+        Ok(self.loop_command(ctx, prompt, true))
+    }
+
+    fn configure_auto_continue(&self, ctx: &AgentContext) -> AgentResult<()> {
+        ctx.validate()?;
+        write_file(&ctx.paths.runtime_dir.join(LOOP_FILE), LOOP_PY)?;
+        std::fs::create_dir_all(state_dir(ctx).join("sessions"))?;
+        let home = agent_home_dir(ctx);
+        match self.kind {
+            LoopKind::Pi => {
+                std::fs::create_dir_all(home.join(".pi/agent/sessions"))?;
+                write_json_file(&home.join(".pi/agent/models.json"), &pi_models_json(ctx)?)?;
+            }
+            LoopKind::Dsh => {
+                std::fs::create_dir_all(home.join(".dsh/sessions"))?;
+                write_json_file(&home.join(DSH_PATCH), &dsh_patch(ctx)?)?;
+            }
+        }
+        if ctx.settings.sandbox_enabled {
+            write_sandbox_hosts_file(ctx)?;
+        }
+        Ok(())
+    }
+
+    fn transcript_parser(&self) -> Box<dyn TranscriptLineParser> {
+        Box::new(CodexTranscriptParser)
+    }
+
+    fn collect_transcripts(&self, ctx: &AgentContext) -> AgentResult<()> {
+        let sessions = state_dir(ctx).join("sessions");
+        let Ok(entries) = std::fs::read_dir(&sessions) else {
+            return Ok(());
+        };
+        std::fs::create_dir_all(&ctx.paths.transcript_dir)?;
+        for entry in entries.flatten() {
+            let path = entry.path();
+            let name = entry.file_name();
+            let is_rollout = name.to_str().is_some_and(|n| n.starts_with("rollout-") && n.ends_with(".jsonl"));
+            // Regular files only: the sandbox can write here.
+            if is_rollout && std::fs::symlink_metadata(&path).is_ok_and(|meta| meta.is_file()) {
+                std::fs::copy(&path, ctx.paths.transcript_dir.join(&name))?;
+            }
+        }
+        if let Ok(session) = std::fs::read_to_string(state_dir(ctx).join("session_id")) {
+            if !session.trim().is_empty() {
+                create_parent_dir(&ctx.paths.session_id_file)?;
+                std::fs::write(&ctx.paths.session_id_file, format!("{}\n", session.trim()))?;
+            }
+        }
+        Ok(())
+    }
+
+    fn sandbox_requirements(&self, ctx: &AgentContext) -> AgentResult<SandboxRequirements> {
+        ctx.validate()?;
+        Ok(SandboxRequirements {
+            read_only_paths: vec![ctx.paths.prompt_file.clone(), self.binary.clone()],
+            writable_paths: vec![
+                ctx.paths.workspace_dir.clone(),
+                ctx.paths.agent_home_dir.clone(),
+                ctx.paths.runtime_dir.clone(),
+                ctx.paths.transcript_dir.clone(),
+                ctx.paths.log_file.parent().unwrap_or_else(|| Path::new("")).to_path_buf(),
+            ],
+            env_vars: vec![
+                "HOME".to_string(),
+                "PATH".to_string(),
+                BASE_URL_ENV.to_string(),
+                TOKEN_ENV.to_string(),
+            ],
+            needs_network: ctx.settings.sandbox_enabled,
+        })
+    }
+}
+
+impl LoopAgent {
+    fn harness_argv(&self, ctx: &AgentContext) -> Vec<String> {
+        let sandbox = ctx.sandbox.as_ref();
+        let node = sandbox
+            .and_then(|layout| layout.codex_guest_node())
+            .map(|path| path.display().to_string())
+            .unwrap_or_else(|| "node".to_string());
+        let program = sandbox
+            .map(|layout| layout.codex_guest_program())
+            .unwrap_or_else(|| self.binary.clone());
+        let mut argv = vec![node, program.display().to_string()];
+        match self.kind {
+            LoopKind::Pi => {
+                let prompt = guest_prompt_file(ctx).display().to_string();
+                argv.extend(
+                    [
+                        "--provider", PROVIDER, "--model", ctx.settings.model.as_str(), "-p", "--mode", "json",
+                        "--offline", "--no-extensions", "--no-skills", "--no-prompt-templates", "--no-mcp",
+                        "--no-themes", "--append-system-prompt", prompt.as_str(),
+                    ]
+                    .map(str::to_string),
+                );
+            }
+            LoopKind::Dsh => {
+                let patch = ctx.guest_home().join(DSH_PATCH).display().to_string();
+                argv.extend(["headless", "--patch", patch.as_str(), "--json"].map(str::to_string));
+            }
+        }
+        argv.extend(ctx.settings.extra_args.clone());
+        argv
+    }
+
+    fn loop_command(&self, ctx: &AgentContext, prompt: &str, resume: bool) -> CommandSpec {
+        let home = ctx.guest_home();
+        let mut command = CommandSpec::new("python3", ctx.guest_path(&ctx.paths.workspace_dir))
+            .arg(guest_loop_file(ctx).display().to_string())
+            .arg("--kind")
+            .arg(self.kind.name())
+            .arg("--state-dir")
+            .arg(guest_state_dir(ctx).display().to_string())
+            .arg("--prompt")
+            .arg(prompt)
+            .arg("--continue-prompt")
+            .arg(&ctx.settings.auto_continue_prompt);
+        if resume {
+            command = command.arg("--resume");
+        }
+        command = command.arg("--");
+        command.args.extend(self.harness_argv(ctx));
+        let command = command
+            .envs(ctx.settings.env.clone())
+            .env("HOME", home.display().to_string());
+        match self.kind {
+            LoopKind::Pi => command
+                .env("PI_CODING_AGENT_DIR", home.join(".pi/agent").display().to_string())
+                .env("PI_OFFLINE", "1")
+                .env("PI_TELEMETRY", "0"),
+            // The Clawblox bubblewrap is the boundary, as for Codex's
+            // externally sandboxed mode; headless DSH has nobody to approve.
+            LoopKind::Dsh => command
+                .env("DSH_HOME", home.join(".dsh").display().to_string())
+                .env("DSH_TELEMETRY_MODE", "DISABLED")
+                .env("DSH_PERMISSION_MODE", "danger-full-access"),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::agent::{AgentPaths, AgentSettings};
+
+    fn context(env: Vec<(&str, &str)>) -> AgentContext {
+        let root = std::env::temp_dir().join(format!("clawblox-loop-test-{}-{}", std::process::id(), rand_suffix()));
+        AgentContext {
+            paths: AgentPaths {
+                workspace_dir: root.join("workspace"),
+                prompt_file: root.join("runtime/system_prompt.md"),
+                session_id_file: root.join("loop_session_id.txt"),
+                transcript_dir: root.join("session"),
+                runtime_dir: root.join("runtime"),
+                log_file: root.join("logs/agent.log"),
+                agent_home_dir: root.join("home"),
+            },
+            settings: AgentSettings {
+                model: "agentx-primary".to_string(),
+                permission_mode: "bypassPermissions".to_string(),
+                initial_prompt: "Begin.".to_string(),
+                lifecycle_prompt: "Wrap up".to_string(),
+                auto_continue_prompt: "Keep going".to_string(),
+                extra_args: Vec::new(),
+                env: env.into_iter().map(|(k, v)| (k.to_string(), v.to_string())).collect(),
+                sandbox_enabled: true,
+                version: None,
+            },
+            sandbox: None,
+        }
+    }
+
+    fn rand_suffix() -> u128 {
+        std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos()
+    }
+
+    fn isolated() -> Vec<(&'static str, &'static str)> {
+        vec![
+            ("CLAWBLOX_NET_ALLOW", "127.0.0.1:41000@8443"),
+            (BASE_URL_ENV, "http://127.0.0.1:8443/api/llm/v1"),
+            (TOKEN_ENV, "ephemeral"),
+            (CONTEXT_ENV, "65536"),
+        ]
+    }
+
+    #[test]
+    fn base_url_must_be_an_allowed_loopback_relay() {
+        assert_eq!(provider_base_url(&context(isolated())).unwrap(), "http://127.0.0.1:8443/api/llm/v1");
+        for url in [
+            "https://agentx.example/api/llm/v1",
+            "http://127.0.0.1:9999/api/llm/v1",
+            "http://127.0.0.1:8443",
+            "http://127.0.0.1:8443/api/../health",
+            "http://127.0.0.1:8443/api/llm/v1?x=1",
+        ] {
+            let mut env = isolated();
+            env[1] = (BASE_URL_ENV, url);
+            assert!(provider_base_url(&context(env)).is_err(), "{url} must refuse");
+        }
+        let mut env = isolated();
+        env.remove(1);
+        assert!(provider_base_url(&context(env)).is_err());
+    }
+
+    #[test]
+    fn generated_configs_name_only_the_alias_and_never_the_token_value() {
+        let ctx = context(isolated());
+        ctx.prepare_paths().unwrap();
+        std::fs::write(&ctx.paths.prompt_file, "Island prompt").unwrap();
+        let pi = pi_models_json(&ctx).unwrap().to_string();
+        assert!(pi.contains("\"$AGENTX_LLM_TOKEN\"") && !pi.contains("ephemeral"));
+        assert!(pi.contains("\"id\":\"agentx-primary\"") && pi.contains("\"contextWindow\":65536"));
+        let dsh = dsh_patch(&ctx).unwrap().to_string();
+        assert!(dsh.contains("\"apiKeyEnv\":\"AGENTX_LLM_TOKEN\"") && !dsh.contains("ephemeral"));
+        assert!(dsh.contains("\"personaSuffix\":\"Island prompt\""));
+        for id in DSH_DISABLED {
+            assert!(dsh.contains(&format!("{{\"disabled\":true,\"id\":\"{id}\"}}")), "{id} must be disabled");
+        }
+    }
+
+    #[test]
+    fn configure_writes_loop_and_config_into_the_generated_home_only() {
+        for kind in [LoopKind::Pi, LoopKind::Dsh] {
+            let ctx = context(isolated());
+            ctx.prepare_paths().unwrap();
+            std::fs::write(&ctx.paths.prompt_file, "Island prompt").unwrap();
+            LoopAgent::new(kind, Some(PathBuf::from("/bin/echo"))).configure_auto_continue(&ctx).unwrap();
+            assert_eq!(std::fs::read_to_string(ctx.paths.runtime_dir.join(LOOP_FILE)).unwrap(), LOOP_PY);
+            let home = super::super::sandbox_home_dir(&ctx);
+            let config = match kind {
+                LoopKind::Pi => home.join(".pi/agent/models.json"),
+                LoopKind::Dsh => home.join(DSH_PATCH),
+            };
+            assert!(config.is_file());
+            assert!(!home.join(".codex/auth.json").exists() && !home.join(".pi/agent/auth.json").exists());
+        }
+    }
+
+    #[test]
+    fn start_is_a_fresh_session_and_continue_resumes_the_recorded_one() {
+        let ctx = context(isolated());
+        ctx.prepare_paths().unwrap();
+        let agent = LoopAgent::new(LoopKind::Pi, Some(PathBuf::from("/bin/echo")));
+        let start = agent.start(&ctx).unwrap();
+        assert_eq!(start.program, PathBuf::from("python3"));
+        assert!(!start.args.contains(&"--resume".to_string()));
+        assert!(start.args.windows(2).any(|w| w == ["--prompt", "Begin."]));
+        assert!(start.args.windows(2).any(|w| w == ["--continue-prompt", "Keep going"]));
+        assert!(start.args.iter().any(|a| a == "--append-system-prompt"));
+        assert!(start.env.iter().any(|(k, v)| k == "PI_OFFLINE" && v == "1"));
+        assert!(agent.continue_session(&ctx, "continue").is_err(), "no recorded session yet");
+        let state = super::state_dir(&ctx);
+        std::fs::create_dir_all(&state).unwrap();
+        std::fs::write(state.join("session_id"), "abc-123\n").unwrap();
+        let resume = agent.continue_session(&ctx, "Update your memory").unwrap();
+        assert!(resume.args.contains(&"--resume".to_string()));
+        assert!(resume.args.windows(2).any(|w| w == ["--prompt", "Update your memory"]));
+
+        let dsh = LoopAgent::new(LoopKind::Dsh, Some(PathBuf::from("/bin/echo"))).start(&ctx).unwrap();
+        assert!(dsh.args.windows(2).any(|w| w == ["headless", "--patch"]));
+        assert!(dsh.env.iter().any(|(k, v)| k == "DSH_PERMISSION_MODE" && v == "danger-full-access"));
+    }
+
+    #[test]
+    fn collect_copies_regular_rollouts_only() {
+        let ctx = context(isolated());
+        ctx.prepare_paths().unwrap();
+        let sessions = super::state_dir(&ctx).join("sessions");
+        std::fs::create_dir_all(&sessions).unwrap();
+        std::fs::write(sessions.join("rollout-s1.jsonl"), "{}\n").unwrap();
+        std::fs::write(sessions.join("notes.txt"), "x").unwrap();
+        std::os::unix::fs::symlink("/etc/passwd", sessions.join("rollout-evil.jsonl")).unwrap();
+        std::fs::write(super::state_dir(&ctx).join("session_id"), "s1\n").unwrap();
+        LoopAgent::new(LoopKind::Pi, None).collect_transcripts(&ctx).unwrap();
+        assert!(ctx.paths.transcript_dir.join("rollout-s1.jsonl").is_file());
+        assert!(!ctx.paths.transcript_dir.join("notes.txt").exists());
+        assert!(!ctx.paths.transcript_dir.join("rollout-evil.jsonl").exists());
+        assert_eq!(std::fs::read_to_string(&ctx.paths.session_id_file).unwrap(), "s1\n");
+    }
+
+    #[test]
+    fn harness_root_is_the_outermost_node_modules() {
+        let root = std::env::temp_dir().join(format!("clawblox-harness-root-{}", rand_suffix()));
+        let entry = root.join("node_modules/@scope/tool/node_modules/dep/cli.js");
+        std::fs::create_dir_all(entry.parent().unwrap()).unwrap();
+        std::fs::write(&entry, "").unwrap();
+        let (found, rel) = harness_root_for_bin(&entry).unwrap();
+        assert_eq!(found, std::fs::canonicalize(&root).unwrap());
+        assert_eq!(rel, PathBuf::from("/node_modules/@scope/tool/node_modules/dep/cli.js"));
+        assert!(harness_root_for_bin(Path::new("/bin/sh")).is_none());
+    }
+}
