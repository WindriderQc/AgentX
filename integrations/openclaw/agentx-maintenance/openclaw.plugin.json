{
  "id": "agentx-maintenance",
  "name": "AgentX Maintenance Actions",
  "version": "1.1.0",
  "description": "Bounded AgentX maintenance actions for operator agents: status, deploy, quarantine recovery, judge calibration and approved Benchmark batches.",
  "activation": {
    "onStartup": true,
    "onAgentHarnesses": [
      "openclaw"
    ]
  },
  "contracts": {
    "tools": [
      "agentx_maintenance_action"
    ]
  },
  "toolMetadata": {
    "agentx_maintenance_action": {
      "optional": true
    }
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "actionCommand": {
        "type": "string"
      },
      "agentIds": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "agentActions": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "status",
              "deploy",
              "recover-quarantine",
              "recalibrate-judges",
              "benchmark-batch-prepare",
              "benchmark-batch-start",
              "benchmark-batch-status"
            ]
          }
        }
      },
      "agentxUrl": {
        "type": "string"
      },
      "queueCommand": {
        "type": "string"
      }
    },
    "additionalProperties": false,
    "required": [
      "actionCommand"
    ]
  }
}
