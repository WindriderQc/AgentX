{
  "id": "super-dad-memory",
  "name": "Nestor Personal Harness",
  "version": "2.3.1",
  "description": "Native OpenClaw tools and receipts backed by canonical AgentX Core notes and tasks.",
  "activation": {
    "onStartup": true,
    "onAgentHarnesses": [
      "openclaw"
    ]
  },
  "contracts": {
    "tools": [
      "personal_memory",
      "mail_journal",
      "team_brief",
      "personal_identifier",
      "vault_note",
      "nestor_context",
      "nestor_briefing",
      "nestor_network",
      "nestor_storage",
      "nestor_files",
      "nestor_gpus",
      "local_image",
      "work_queue",
      "conversation_work"
    ]
  },
  "toolMetadata": {
    "personal_memory": {
      "optional": true
    },
    "mail_journal": {
      "optional": true
    },
    "team_brief": {
      "optional": true
    },
    "personal_identifier": {
      "optional": true
    },
    "vault_note": {
      "optional": true
    },
    "nestor_context": {
      "optional": true
    },
    "nestor_briefing": {
      "optional": true
    },
    "nestor_network": {
      "optional": true
    },
    "nestor_storage": {
      "optional": true
    },
    "nestor_files": {
      "optional": true
    },
    "nestor_gpus": {
      "optional": true
    },
    "local_image": {
      "optional": true
    },
    "work_queue": {
      "optional": true
    },
    "conversation_work": {
      "optional": true
    }
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "agentxUrl": {
        "type": "string"
      },
      "secretarySessionKeys": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "briefingSessionKeys": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "mediaRoot": {
        "type": "string",
        "description": "OpenClaw media directory served read-only to Household for generated images. Default: <state dir>/media."
      },
      "conversationWorkAgentId": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$",
        "description": "Internal native worker; omitted from the public agent catalog."
      },
      "conversationWorkToken": {
        "type": "string",
        "minLength": 32,
        "description": "Private Core native work binding token; never a tool argument."
      }
    },
    "additionalProperties": false,
    "required": [
      "agentxUrl"
    ]
  },
  "uiHints": {
    "conversationWorkToken": {
      "label": "Private Core work binding",
      "sensitive": true
    },
    "conversationWorkAgentId": {
      "label": "Internal native worker"
    }
  }
}
