{
  "name": "@agentx/dsh-coding-team",
  "version": "0.3.1",
  "private": true,
  "description": "Native coding worker conversations and isolated human continuation in DSH Studio",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.0-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2 || 0.2.1-rc.3",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.0-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.0-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-session": "0.2.0-rc.2 || 0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    }
  }
}
