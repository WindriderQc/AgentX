{
  "name": "agentx",
  "version": "1.4.1",
  "description": "Local AI assistant with RAG, conversation memory, prompt versioning, and n8n integration support.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "scan:features": "node scripts/feature-alignment-scan.js --root .",
    "validate": "node scripts/comprehensive-validation.js",
    "test": "node scripts/run-jest.js --silent",
    "test:ci": "node scripts/run-jest.js --silent --detectOpenHandles",
    "test:debug:handles": "node --max-old-space-size=4096 ./node_modules/jest/bin/jest.js --detectOpenHandles --runInBand",
    "test:unit": "node --max-old-space-size=4096 ./node_modules/jest/bin/jest.js tests/unit --coverage",
    "test:integration": "node --max-old-space-size=4096 ./node_modules/jest/bin/jest.js tests/integration --runInBand",
    "test:workflows": "node --max-old-space-size=4096 ./node_modules/jest/bin/jest.js tests/workflows",
    "test:e2e": "node scripts/run-posix-script.js test-all.sh",
    "test:e2e:playwright": "npx playwright test",
    "test:e2e:playwright:ui": "npx playwright test --ui",
    "test:e2e:playwright:headed": "npx playwright test --headed",
    "test:e2e:playwright:debug": "npx playwright test --debug",
    "test:e2e:playwright:report": "npx playwright show-report",
    "test:e2e:export-import": "npx playwright test export-import.spec.js",
    "test:e2e:onboarding": "npx playwright test onboarding-wizard",
    "test:e2e:dashboard": "npx playwright test performance-metrics-dashboard",
    "test:e2e:filtering": "npx playwright test advanced-filtering.spec.js --project=chromium",
    "test:e2e:filtering:headed": "npx playwright test advanced-filtering.spec.js --headed --project=chromium",
    "test:e2e:filtering:debug": "npx playwright test advanced-filtering.spec.js --debug --project=chromium",
    "test:watch": "node --max-old-space-size=4096 ./node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --max-old-space-size=4096 ./node_modules/jest/bin/jest.js --coverage",
    "test:load": "node scripts/run-posix-script.js tests/load/run-tests.sh",
    "test:load:basic": "artillery run tests/load/basic-load.yml",
    "test:load:stress": "artillery run tests/load/stress-test.yml",
    "test:load:comprehensive": "artillery run tests/load/comprehensive-load.yml",
    "test:load:import": "node scripts/run-posix-script.js scripts/import-artillery-results.sh basic-load",
    "perf:baseline": "node scripts/run-posix-script.js scripts/create-performance-baseline.sh",
    "perf:check": "node scripts/run-posix-script.js scripts/check-performance-regression.sh",
    "db:optimize": "node scripts/optimize-database-indexes.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "seed:ops": "node scripts/seed-sbqc-ops.js"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@qdrant/js-client-rest": "^1.16.2",
    "ajv": "^8.17.1",
    "bcryptjs": "^3.0.3",
    "chokidar": "^5.0.0",
    "compression": "^1.8.1",
    "connect-mongodb-session": "^5.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cron-parser": "^5.5.0",
    "dompurify": "^3.3.1",
    "dotenv": "^17.2.3",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "form-data": "^4.0.1",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^3.0.5",
    "ioredis": "^5.9.0",
    "isomorphic-dompurify": "^2.35.0",
    "mongoose": "^8.9.5",
    "multer": "^2.0.2",
    "node-fetch": "^2.7.0",
    "nodemailer": "^6.10.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/jest": "^29.5.0",
    "artillery": "^2.0.27",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.2.1",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4"
  },
  "overrides": {
    "mongodb": "^6.5.0",
    "bson": "^6.5.0"
  },
  "engines": {
    "node": ">=18.14.0 || ^20.0.0 || ^21.0.0 || ^22.0.0 || >=23.0.0"
  }
}
