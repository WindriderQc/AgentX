# ==============================================
# AgentX Configuration Template
# Copy this file to .env and customize for your environment.
# ==============================================

# ----------------------------------------------
# 1. Server Configuration
# ----------------------------------------------
# Port to run the AgentX server on
PORT=3080
# Host to bind to (localhost or 0.0.0.0)
HOST=localhost
# Environment: development, production, test
NODE_ENV=development
# Publicly accessible host (for links/redirects)
SERVER_HOST=localhost

# ----------------------------------------------
# 2. Database Configuration (MongoDB)
# ----------------------------------------------
# Connection string for MongoDB (Required)
MONGODB_URI=mongodb://localhost:27017/agentx

# ----------------------------------------------
# 3. Security & Authentication (REQUIRED)
# ----------------------------------------------
# Generate strong random secrets (min 32 characters)
# Run: node -e "const crypto = require('crypto'); console.log(crypto.randomBytes(32).toString('hex'));"

# Session encryption secret
SESSION_SECRET=change-this-to-a-random-secret-min-32-characters-long
# CSRF protection secret
CSRF_SECRET=change-this-to-a-different-random-secret-min-32-characters-long
# API key for programmatic access (e.g., from n8n or scripts)
AGENTX_API_KEY=your-secure-api-key-for-automation-access

# CORS Configuration (comma-separated origins for production)
# Leave unset for development (allows all origins)
# CORS_ORIGINS=http://localhost:3080,https://myapp.com

# ----------------------------------------------
# 4. AI Model Configuration (Ollama)
# ----------------------------------------------
# URL of your local Ollama instance (Required)
OLLAMA_HOST=http://192.168.1.100:11434
# OLLAMA_HOST_SECONDARY=http://192.168.1.101:11434
# Model to use for generating embeddings (must be pulled in Ollama)
EMBEDDING_MODEL=nomic-embed-text

# Optional: SSH-based NVIDIA VRAM metrics for Ollama hosts
# AgentX will SSH into each configured OLLAMA_HOST* machine and run `nvidia-smi`.
# Required on the AgentX server host: `ssh` client installed.
OLLAMA_SSH_USER=ollama
# Optional: override SSH username per host (useful when one host is Windows).
# Format: host=user,host2=user2
# Example: OLLAMA_SSH_USER_MAP=192.168.2.99=yb,192.168.2.12=Yanik
# OLLAMA_SSH_USER_MAP=
# OLLAMA_SSH_PORT=22
# Optional: specify a private key file path (otherwise system SSH config/default keys are used)
# OLLAMA_SSH_KEY_PATH=/home/agentx/.ssh/id_ed25519
# OLLAMA_SSH_TIMEOUT_MS=3000
# OLLAMA_VRAM_CACHE_MS=5000
# Optional: comma-separated list of Ollama hosts to skip for SSH VRAM collection.
# Useful for Windows-based Ollama hosts or any host without sshd/nvidia-smi available.
# OLLAMA_SSH_DISABLED_HOSTS=192.168.2.12
# Host key checking behavior (OpenSSH StrictHostKeyChecking value: yes|no)
# OLLAMA_SSH_STRICT_HOST_KEY_CHECKING=no

# ----------------------------------------------
# 5. Vector Store Configuration (RAG)
# ----------------------------------------------
# Storage backend: 'qdrant' (recommended) or 'memory' (testing only)
VECTOR_STORE_TYPE=qdrant

# Qdrant Configuration (Required if VECTOR_STORE_TYPE=qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=agentx_embeddings

# RAG Contextual Compression
COMPRESSION_MODEL=gemma2:2b
COMPRESSION_MIN_RELEVANCE=0.6
COMPRESSION_MAX_SENTENCES=5
COMPRESSION_CACHE_TTL=3600000

# ----------------------------------------------
# 6. DataAPI Integration (Optional)
# ----------------------------------------------
# URL of the companion DataAPI service
DATAAPI_BASE_URL=http://localhost:3003
# API Key for DataAPI (must match DATAAPI_API_KEY in DataAPI/.env)
DATAAPI_API_KEY=change-me-long-random

# ----------------------------------------------
# 7. n8n Integration (Optional)
# ----------------------------------------------
# Base URL for n8n webhooks (for automated workflows)
N8N_WEBHOOK_BASE_URL=https://n8n.example.com/webhook
# API Key for n8n to authenticate with AgentX (must match n8n's x-api-key header)
N8N_API_KEY=your-secure-n8n-api-key-here
# Optional: Restrict n8n access to LAN only (true/false)
N8N_LAN_ONLY=false
# Webhook timeout for AI operations (milliseconds)
N8N_WEBHOOK_TIMEOUT_MS=120000

# n8n Webhook IDs (optional - specific webhook endpoints)
N8N_WEBHOOK_RAG_INGEST=rag-ingest-webhook-id
N8N_WEBHOOK_CHAT_COMPLETE=chat-complete-webhook-id
N8N_WEBHOOK_ANALYTICS=analytics-webhook-id
N8N_WEBHOOK_GENERIC=generic-webhook-id

# ----------------------------------------------
# 8. Alerting & Notifications
# ----------------------------------------------
# Outgoing alert email settings
ALERT_EMAIL_FROM=alerts@example.com
ALERT_EMAIL_TO=ops@example.com

# SMTP configuration for sending alert emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Slack webhook for alert notifications
SLACK_WEBHOOK_URL=<your_slack_webhook_url>

# ----------------------------------------------
# 9. Cost Tracking Configuration (V5)
# ----------------------------------------------
# Enable/disable cost tracking globally
COST_TRACKING_ENABLED=true

# Currency for cost calculations (ISO 4217 code)
COST_CURRENCY=USD

# Ollama Default Pricing (local models = free by default)
# Per million tokens (prompt and completion)
OLLAMA_DEFAULT_PROMPT_COST_PER_1M=0.00
OLLAMA_DEFAULT_COMPLETION_COST_PER_1M=0.00

# Global Fallback Pricing (when model not found in DB or env vars)
DEFAULT_FALLBACK_PROMPT_COST_PER_1M=0.00
DEFAULT_FALLBACK_COMPLETION_COST_PER_1M=0.00

# Cost Tracking Cache TTL (in seconds, default: 3600 = 1 hour)
COST_PRICING_CACHE_TTL=3600
