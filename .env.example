# Database Configuration
MONGODB_URI=mongodb://192.168.2.33:27017/agentx

# Server Configuration
PORT=3080
HOST=localhost
NODE_ENV=development
SERVER_HOST=localhost
CORS_ORIGINS=*

# RAG / Ollama
